---
// 页脚：Song 那句公司的话 + 宇宙地址，第一版原样搬过来，一个字不改。子页面再多一个「飞鸽传书」。
import T from './T.astro';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const mail = ['oilsongchengmin', 'gmail.com'].join('@');
---
<footer class={`ft ${compact ? 'ft-compact' : ''}`}>
  <p class="ft-co"><span class="ft-name" lang="zh-CN">零肉身造物 | Zero-Flesh Creation</span> <T k="company.p1" /> <T k="company.motto" /></p>
  <T as="p" class="ft-addr" k="company.addr" />
  {!compact && (
    <p class="ft-mail"><a href={`mailto:${mail}?subject=${encodeURIComponent('零肉身造物 · Zero-Flesh Creation')}`} title={mail}><T k="foot.mail" /></a></p>
  )}
</footer>
