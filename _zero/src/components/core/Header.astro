---
// 顶栏：左右对称——左 EN / 中文，右 SOUND: OFF；子页面中间一个小 wordmark（点它回首页），下面一行五道门。
// 首页中间是「目录 / INDEX」（v3.2）：点一下，世界快进到结尾「开天」那片天，五个名字挂在五样造物上让你挑。字体字号跟声音开关一个样，七幕全程都在。
// 首页不放中间那个 wordmark（首页自己有大的），也不放五道门那行（五个名字在天上）。
import { t, ENTRIES, type EntryKey } from '../../i18n/ui';

interface Props { home?: boolean; current?: EntryKey | null }
const { home = false, current = null } = Astro.props;
---
<header class="hd" data-home={home ? '' : undefined}>
  <a class="skip" href="#main"><span data-l="en">{t('en', 'site.skip')}</span><span data-l="zh">{t('zh', 'site.skip')}</span></a>
  <div class="hd-row">
    <div class="hd-l">
      <div class="toggle" role="group" aria-label={t('en', 'lang.label')} data-aria-en={t('en', 'lang.label')} data-aria-zh={t('zh', 'lang.label')}>
        <button type="button" data-lang-set="en" lang="en" aria-pressed="true">EN</button><span class="sep" aria-hidden="true">/</span><button type="button" data-lang-set="zh" lang="zh-CN" aria-pressed="false">中文</button>
      </div>
    </div>
    {home ? (
      <button type="button" class="idx" data-index aria-controls="sky-index">
        <span data-l="en" lang="en">INDEX</span><span data-l="zh" lang="zh-CN">目录</span>
      </button>
    ) : (
      <a class="hd-mark" href="/" aria-label={`${t('en', 'nav.home')} · Zero-Flesh Creation`} data-aria-en={`${t('en', 'nav.home')} · Zero-Flesh Creation`} data-aria-zh={`${t('zh', 'nav.home')} · 零肉身造物`}>
        <span class="a" data-l="en">ZERO-FLESH CREATION</span><span class="b" data-l="en" lang="zh-CN">零肉身造物</span>
        <span class="a" data-l="zh" lang="zh-CN">零肉身造物</span><span class="b" data-l="zh">ZERO-FLESH CREATION</span>
      </a>
    )}
    <div class="hd-r">
      <button type="button" class="snd" data-sound-toggle aria-pressed="false">
        <span data-l="en" lang="en">SOUND: <span class="st-off">OFF</span><span class="st-on">ON</span></span><span data-l="zh" lang="zh-CN">声音：<span class="st-off">关</span><span class="st-on">开</span></span>
      </button>
    </div>
  </div>
  {!home && (
    <nav class="hd-nav" aria-label={t('en', 'nav.label')} data-aria-en={t('en', 'nav.label')} data-aria-zh={t('zh', 'nav.label')}>
      <ol>
        {ENTRIES.map((e, i) => (
          <li>
            <a href={e.href} aria-current={current === e.key ? 'page' : undefined}>
              <span class="no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="nm" data-l="en" lang="en">{t('en', `entry.${e.key}.name`)}</span><span class="nm" data-l="zh" lang="zh-CN">{t('zh', `entry.${e.key}.name`)}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )}
</header>
