---
// 顶栏：左边牌子 + 三个栏目，右边 [肉身 | 无头]、声音开关、EN / 中文（策划书 §3.2：开关在导航栏右侧，静音在右上角）。
import T from './T.astro';
import { t } from '../../i18n/ui';

interface Props { current?: 'home' | 'specimens' | 'artifacts' | 'codex' | 'zhahuopu' }
const { current = 'home' } = Astro.props;
const items = [
  { key: 'specimens', href: '/specimens/' },
  { key: 'artifacts', href: '/artifacts/' },
  { key: 'codex', href: '/codex/' },
] as const;
---
<header class="top">
  <a class="skip" href="#main"><T k="site.skip" /></a>
  <div class="wrap top-in">
    <a class="brand" href="/" aria-label="零肉身造物 · Assetless Genesis" data-sfx="tick">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-zh" lang="zh-CN">零肉身造物</span>
      <span class="brand-en">ASSETLESS GENESIS</span>
    </a>
    <nav class="nav" aria-label={t('en', 'nav.label')} data-aria-en={t('en', 'nav.label')} data-aria-zh={t('zh', 'nav.label')}>
      {items.map((it) => (
        <a href={it.href} aria-current={current === it.key ? 'page' : undefined} data-sfx="tick"><T k={`nav.${it.key}`} /></a>
      ))}
    </nav>
    <div class="top-r">
      <div class="seg mode" role="group" aria-label={t('en', 'mode.label')} data-aria-en={t('en', 'mode.label')} data-aria-zh={t('zh', 'mode.label')}>
        <button type="button" data-mode-set data-v="render" aria-pressed="true"><T k="mode.render" /></button>
        <button type="button" data-mode-set data-v="headless" aria-pressed="false"><T k="mode.headless" /></button>
      </div>
      <button type="button" class="sfx" data-sfx-toggle aria-pressed="true" aria-label={t('en', 'sfx.label')} data-aria-en={t('en', 'sfx.label')} data-aria-zh={t('zh', 'sfx.label')}>
        <i aria-hidden="true"><b></b><b></b><b></b></i>
      </button>
      <div class="seg lang" role="group" aria-label={t('en', 'lang.label')} data-aria-en={t('en', 'lang.label')} data-aria-zh={t('zh', 'lang.label')}>
        <button type="button" data-lang-set="en" lang="en" aria-pressed="true">EN</button>
        <button type="button" data-lang-set="zh" lang="zh-CN" aria-pressed="false">中文</button>
      </div>
    </div>
  </div>
</header>

<style>
  .skip { position: absolute; left: 12px; top: -60px; z-index: 50; background: var(--signal); color: var(--signal-ink); padding: 8px 12px; border-radius: 8px; font-weight: 600; font-size: 14px; }
  .skip:focus { top: 8px; }
  /* 手机：一行放牌子和三个开关，栏目挪到第二行，横着能滑 */
  @media (max-width: 860px) {
    .brand-en { display: none; }
  }
  @media (max-width: 720px) {
    .top-in { height: auto; flex-wrap: wrap; row-gap: 0; padding-top: 6px; }
    .nav { order: 3; width: 100%; margin: 0 0 0 -10px; overflow-x: auto; scrollbar-width: none; }
    .nav::-webkit-scrollbar { display: none; }
    .nav a { min-height: 40px; }
    .top-r { gap: 6px; }
  }
  @media (max-width: 400px) {
    .brand-zh { font-size: 15px; }
    .top-r :global(.seg button) { min-width: 40px; padding: 0 8px; }
  }
</style>
