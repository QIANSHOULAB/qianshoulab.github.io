---
// Codex-01 声学公式测试板的外壳。compact：只有三颗发声按钮和一小块示波器（嵌进样本 001 正文用）。
import T from '../core/T.astro';
import { PRESETS } from './AudioSynthLab';
import { t } from '../../i18n/ui';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<div class={`bench slab ${compact ? 'compact' : ''}`} data-bench data-compact={String(compact)} aria-label={t('en', 'bench.label')} data-aria-en={t('en', 'bench.label')} data-aria-zh={t('zh', 'bench.label')} role="group">
  {compact ? (
    <div class="pads">
      {PRESETS.map((p) => (
        <button type="button" class="pad" data-play={p.id}>
          <span class="pad-name"><T k={`bench.${p.id}`} /></span>
          <span class="pad-f mono"><T k={`bench.f${p.id}`} /></span>
        </button>
      ))}
    </div>
    <div class="scope" data-scope><span class="scope-tag mono">scope</span></div>
    <p class="bench-foot"><T k="bench.hint" /> <a href="/codex/web-audio-formulas/"><T k="bench.full" /> →</a></p>
  ) : (
    <>
      <div class="bench-head">
        <div class="picks" role="group">
          {PRESETS.map((p, i) => (
            <button type="button" data-pick={p.id} aria-pressed={i === 0 ? 'true' : 'false'}><T k={`bench.${p.id}`} /></button>
          ))}
        </div>
        {PRESETS.map((p, i) => (
          <button type="button" class="btn solid play" data-play={p.id} hidden={i !== 0} data-play-main><span class="tri" aria-hidden="true"></span><T k="bench.play" /></button>
        ))}
      </div>
      <div class="scope big" data-scope><span class="scope-tag mono">scope · 2048 samples</span></div>
      {PRESETS.map((p, i) => (
        <div class="knobs" data-knobs={p.id} hidden={i !== 0}>
          {p.knobs.map((k) => (
            <label class="knob">
              <span class="knob-top"><span class="knob-name"><T k={`bench.knobs.${p.id}.${k.key}`} /></span><span class="knob-v mono"><span data-v={`${p.id}.${k.key}`}>{p.defaults[k.key]}</span> {k.unit}</span></span>
              <input type="range" min={k.min} max={k.max} step={k.step} value={p.defaults[k.key]} data-k={`${p.id}.${k.key}`} />
            </label>
          ))}
        </div>
      ))}
      <p class="bench-foot"><T k="bench.hint" /></p>
      <details class="code">
        <summary><T k="bench.code" /></summary>
        <div class="code-in">
          <button type="button" class="btn copy" data-copy><span class="c1"><T k="bench.copy" /></span><span class="c2"><T k="bench.copied" /></span></button>
          <pre><code data-code></code></pre>
        </div>
      </details>
    </>
  )}
</div>

<script>
  import { mountBench } from './AudioSynthLab';
  document.querySelectorAll<HTMLElement>('[data-bench]').forEach((el) => {
    if (el.dataset.mounted) return;
    el.dataset.mounted = '1';
    mountBench(el);
    // 选了哪条公式，主按钮就放哪条
    el.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => b.addEventListener('click', () => {
      el.querySelectorAll<HTMLButtonElement>('[data-play-main]').forEach((p) => { p.hidden = p.dataset.play !== b.dataset.pick; });
    }));
  });
</script>

<style>
  .bench { padding: 20px; margin: 28px 0; }
  .bench-head { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .picks { display: inline-flex; border: 1px solid var(--line); }
  .picks button { appearance: none; border: 0; background: transparent; color: var(--ink-3); cursor: pointer; min-height: 40px; padding: 0 14px; font: 400 12px/1 var(--sans); transition: color var(--t) var(--ease), background var(--t) var(--ease); }
  .picks button + button { border-left: 1px solid var(--line); }
  .picks button:hover { color: var(--ink); }
  .picks button[aria-pressed="true"] { color: #000; background: var(--ink); }
  .play { min-width: 112px; }
  .tri { width: 0; height: 0; border-left: 8px solid currentColor; border-top: 5px solid transparent; border-bottom: 5px solid transparent; }
  .scope { position: relative; height: 96px; border: 1px solid var(--line); background: #030303; overflow: hidden; }
  .scope.big { height: 168px; }
  .scope :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .scope-tag { position: absolute; right: 10px; top: 8px; font-size: 10.5px; letter-spacing: .1em; color: var(--ink-4); z-index: 1; }
  .knobs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px 20px; margin-top: 16px; }
  .knobs[hidden] { display: none; }
  .knob { display: flex; flex-direction: column; gap: 2px; }
  .knob-top { display: flex; justify-content: space-between; gap: 8px; font-size: 13px; }
  .knob-name { color: var(--ink-2); }
  .knob-v { color: var(--ink); font-size: 12.5px; white-space: nowrap; }
  input[type="range"] { -webkit-appearance: none; appearance: none; width: 100%; height: 32px; background: transparent; margin: 0; cursor: pointer; --p: .5; }
  input[type="range"]::-webkit-slider-runnable-track { height: 2px; background: linear-gradient(to right, var(--ink) calc(var(--p) * 100%), var(--line-2) calc(var(--p) * 100%)); }
  input[type="range"]::-moz-range-track { height: 2px; background: var(--line-2); }
  input[type="range"]::-moz-range-progress { height: 2px; background: var(--ink); }
  input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px; border-radius: 50%; background: var(--ink); margin-top: -6px; box-shadow: 0 0 0 4px rgba(255, 255, 255, .08); }
  input[type="range"]::-moz-range-thumb { width: 14px; height: 14px; border: 0; border-radius: 50%; background: var(--ink); box-shadow: 0 0 0 4px rgba(255, 255, 255, .08); }
  input[type="range"]:focus-visible { outline: none; }
  input[type="range"]:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 3px #000, 0 0 0 4px #fff; }
  .bench-foot { margin: 12px 0 0; font-size: 13.5px; color: var(--ink-2); }
  .bench-foot a { color: var(--ink); border-bottom: 1px solid var(--line-2); white-space: nowrap; }
  .code { margin-top: 14px; border-top: 1px solid var(--line); padding-top: 12px; }
  .code summary { cursor: pointer; font: 400 11px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--ink); min-height: 36px; display: flex; align-items: center; gap: 10px; list-style: none; }
  .code summary::-webkit-details-marker { display: none; }
  .code summary::before { content: ""; width: 6px; height: 6px; border-right: 1px solid var(--ink-2); border-bottom: 1px solid var(--ink-2); transform: rotate(-45deg); transition: transform var(--t) var(--ease); }
  .code[open] summary::before { transform: rotate(45deg); }
  .code-in { position: relative; margin-top: 10px; }
  .code pre { margin: 0; padding: 16px; padding-top: 56px; background: #030303; border: 1px solid var(--line); overflow-x: auto; font: 400 12.5px/1.65 var(--mono); color: #cfcfcf; }
  .copy { position: absolute; right: 10px; top: 10px; min-height: 34px; padding: 0 12px; background: #000; }
  .copy .c2 { display: none; }
  .copy:global(.done) .c1 { display: none; }
  .copy:global(.done) .c2 { display: inline; }

  .compact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px; align-items: stretch; }
  .compact .bench-foot { grid-column: 1 / -1; margin-top: 0; }
  .pads { display: grid; gap: 8px; }
  .pad { appearance: none; text-align: left; border: 1px solid var(--line-2); background: rgba(255, 255, 255, .02); color: var(--ink); padding: 10px 14px; cursor: pointer; min-height: 52px; display: flex; flex-direction: column; justify-content: center; gap: 3px; font: inherit; transition: border-color var(--t) var(--ease), background var(--t) var(--ease); }
  .pad:hover { border-color: var(--ink-2); }
  .pad:global(.hit) { animation: hit .35s var(--ease); }
  @keyframes hit { 0% { background: rgba(255, 255, 255, .2); } 100% { background: rgba(255, 255, 255, .02); } }
  .pad-name { font-weight: 600; font-size: 15px; }
  .pad-f { font-size: 11.5px; color: var(--ink-3); }
  .compact .scope { height: auto; min-height: 120px; }
  @media (max-width: 720px) {
    .knobs { grid-template-columns: 1fr 1fr; }
    .compact { grid-template-columns: 1fr; }
    .compact .scope { min-height: 96px; }
  }
  @media (max-width: 400px) { .knobs { grid-template-columns: 1fr; } }
</style>
