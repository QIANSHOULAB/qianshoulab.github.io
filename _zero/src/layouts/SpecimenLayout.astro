---
// 样本档案的专属布局（策划书 §4.2 SpecimenLayout.astro）：
// 自动读 Frontmatter，顶上渲染结构化档案卡 + 实机切片入口，下面是正文。
import BaseLayout from './BaseLayout.astro';
import T from '../components/core/T.astro';
import { ymd, plainLength, type Pair } from '../utils/archive';

interface Props { pair: Pair<'specimens'> }
const { pair } = Astro.props;
const en = pair.en.data, zh = pair.zh.data;
const chars = { en: plainLength(pair.en.body), zh: plainLength(pair.zh.body) };
---
<BaseLayout current="specimens" title={{ en: `Specimen ${en.id} · ${en.title}`, zh: `样本 ${zh.id} · ${zh.title}` }} desc={{ en: en.summary, zh: zh.summary }}>
  <article class="spec wrap">
    <p class="crumb mono"><a href="/specimens/">/specimens</a> / {en.id}</p>
    <h1 class="spec-t"><T en={en.title} zh={zh.title} /></h1>
    <T as="p" class="spec-sum" en={en.summary} zh={zh.summary} />

    <section class="filecard card" aria-labelledby="fc-t">
      <div class="ticks" aria-hidden="true"></div>
      <header class="fc-head">
        <h2 class="fc-t mono" id="fc-t"><T k="specimen.card" /> · SPECIMEN {en.id}</h2>
        <span class="chip live">{ymd(en.date)}</span>
      </header>
      <dl class="fc-grid">
        <div><dt><T k="specimen.id" /></dt><dd class="mono big">{en.id}</dd></div>
        <div><dt><T k="specimen.date" /></dt><dd class="mono"><time datetime={ymd(en.date)}>{ymd(en.date)}</time></dd></div>
        <div><dt><T k="specimen.species" /></dt><dd><T en={en.species} zh={zh.species} /></dd></div>
        <div><dt><T k="specimen.scale" /></dt><dd><T en={en.scale} zh={zh.scale} /></dd></div>
        <div class="wide"><dt><T k="specimen.stack" /></dt><dd class="stack">{en.modelStack.map((m) => <span class="chip">{m}</span>)}</dd></div>
        <div class="wide"><dt><T k="specimen.source" /></dt><dd><a class="ext" href={en.sourceUrl} rel="noopener" target="_blank">{en.sourceLabel} ↗</a></dd></div>
      </dl>
      <div class="fc-actions">
        <a class="btn primary" href={en.liveUrl} rel="noopener" target="_blank"><T k="specimen.play" /> ↗</a>
        <a class="btn" href={en.sourceUrl} rel="noopener" target="_blank"><T k="specimen.post" /> ↗</a>
        <span class="fc-url mono">{en.liveUrl.replace(/^https:\/\//, '').replace(/\/$/, '')}</span>
      </div>
      <p class="hl-only fc-hl mono">chars: en {chars.en.toLocaleString('en-US')} · zh {chars.zh.toLocaleString('en-US')}</p>
    </section>

    <div class="prose-wrap">
      <slot />
    </div>
    <p class="back"><a href="/specimens/">← <T k="specimen.back" /></a></p>
  </article>
</BaseLayout>

<style>
  .spec { padding-top: 48px; }
  .crumb { font-size: 13px; color: var(--faint); margin: 0 0 16px; }
  .crumb a { color: var(--signal); }
  .spec-t { font-size: clamp(32px, 4.4vw, 52px); line-height: 1.12; letter-spacing: -.02em; margin: 0 0 16px; max-width: 18em; text-wrap: balance; }
  :global(html[data-lang="zh"]) .spec-t { letter-spacing: 0; line-height: 1.2; }
  .spec :global(.spec-sum) { font-size: 19px; color: var(--dim); max-width: 40em; margin: 0 0 32px; line-height: 1.55; }
  .filecard { padding: 22px 24px; max-width: 880px; }
  .fc-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .fc-t { margin: 0; font-size: 12.5px; color: var(--dim); font-weight: 500; letter-spacing: .02em; }
  .fc-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 0; border-top: 1px solid var(--line); }
  .fc-grid > div { padding: 14px 16px 14px 0; border-bottom: 1px solid var(--line); }
  .fc-grid .wide { grid-column: span 2; }
  .fc-grid dt { font-size: 12px; color: var(--faint); margin-bottom: 4px; }
  .fc-grid dd { margin: 0; font-size: 15px; }
  .fc-grid dd.big { font-size: 22px; color: var(--signal); }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .ext { color: var(--ink); border-bottom: 1px solid var(--line-2); }
  .ext:hover { border-color: var(--signal); }
  .fc-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; margin-top: 18px; }
  .fc-url { font-size: 12px; color: var(--faint); }
  .fc-hl { margin: 12px 0 0; font-size: 12px; }
  .prose-wrap { max-width: 760px; margin-top: 40px; }
  .back { margin: 48px 0 0; font-size: 15px; }
  .back a { color: var(--signal); }
  @media (max-width: 720px) {
    .spec { padding-top: 28px; }
    .filecard { padding: 18px 18px; }
    .fc-grid { grid-template-columns: 1fr 1fr; }
    .fc-grid .wide { grid-column: 1 / -1; }
    .fc-actions .btn { flex: 1 1 auto; }
  }
</style>
