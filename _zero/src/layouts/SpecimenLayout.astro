---
// 标本的专属布局：自动读 Frontmatter，顶上一张结构化档案卡 + 实机切片入口，下面是正文。
import BaseLayout from './BaseLayout.astro';
import T from '../components/core/T.astro';
import { ymd, type Pair } from '../utils/archive';

interface Props { pair: Pair<'specimens'> }
const { pair } = Astro.props;
const en = pair.en.data, zh = pair.zh.data;
---
<BaseLayout current="specimens" title={{ en: `Specimen ${en.id} · ${en.title}`, zh: `标本 ${zh.id} · ${zh.title}` }} desc={{ en: en.summary, zh: zh.summary }}>
  <article class="spec wrap">
    <p class="crumb label"><a href="/specimens/">03 · <T k="specimens.h1" /></a> <span aria-hidden="true">/</span> {en.id}</p>
    <h1 class="spec-t"><T en={en.title} zh={zh.title} /></h1>
    <T as="p" class="spec-sum" en={en.summary} zh={zh.summary} />

    <section class="filecard slab" aria-labelledby="fc-t">
      <header class="fc-head">
        <h2 class="label fc-t" id="fc-t"><T k="specimen.card" /> · SPECIMEN {en.id}</h2>
        <span class="chip">{ymd(en.date)}</span>
      </header>
      <dl class="fc-grid">
        <div><dt class="label"><T k="specimen.id" /></dt><dd class="big">{en.id}</dd></div>
        <div><dt class="label"><T k="specimen.date" /></dt><dd class="mono"><time datetime={ymd(en.date)}>{ymd(en.date)}</time></dd></div>
        <div><dt class="label"><T k="specimen.species" /></dt><dd><T en={en.species} zh={zh.species} /></dd></div>
        <div><dt class="label"><T k="specimen.scale" /></dt><dd><T en={en.scale} zh={zh.scale} /></dd></div>
        <div class="wide"><dt class="label"><T k="specimen.stack" /></dt><dd class="stack">{en.modelStack.map((m) => <span class="chip">{m}</span>)}</dd></div>
        <div class="wide"><dt class="label"><T k="specimen.source" /></dt><dd><a class="ext" href={en.sourceUrl} rel="noopener" target="_blank">{en.sourceLabel} ↗</a></dd></div>
      </dl>
      <div class="fc-actions">
        <a class="btn solid" href={en.liveUrl} rel="noopener" target="_blank"><T k="specimen.play" /> ↗</a>
        <a class="btn" href={en.sourceUrl} rel="noopener" target="_blank"><T k="specimen.post" /> ↗</a>
        <span class="fc-url label">{en.liveUrl.replace(/^https:\/\//, '').replace(/\/$/, '')}</span>
      </div>
    </section>

    <div class="prose-wrap">
      <slot />
    </div>
    <p class="back"><a class="go" href="/specimens/"><span class="arr" aria-hidden="true">←</span> <T k="specimen.back" /></a></p>
  </article>
</BaseLayout>

<style>
  .spec { padding-top: 56px; max-width: 900px; }
  .crumb { margin: 0 0 22px; }
  .crumb a { color: var(--ink-2); }
  .crumb a:hover { color: var(--ink); }
  .spec-t { font: 500 clamp(34px, 4.6vw, 56px)/1.1 var(--serif); letter-spacing: .01em; margin: 0 0 18px; max-width: 18em; text-wrap: balance; color: var(--ink); }
  :global(html[data-lang="zh"]) .spec-t { font-family: var(--serif-zh); font-size: clamp(28px, 3.8vw, 44px); line-height: 1.3; letter-spacing: .03em; }
  .spec :global(.spec-sum) { font-size: 18px; color: var(--ink-2); max-width: 40em; margin: 0 0 36px; line-height: 1.65; }
  .filecard { padding: 22px 24px; }
  .fc-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .fc-t { margin: 0; font-weight: 400; }
  .fc-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 0; border-top: 1px solid var(--line); }
  .fc-grid > div { padding: 14px 16px 14px 0; border-bottom: 1px solid var(--line); }
  .fc-grid .wide { grid-column: span 2; }
  .fc-grid dt { margin-bottom: 6px; }
  .fc-grid dd { margin: 0; font-size: 15px; color: var(--ink); }
  .fc-grid dd.big { font: 500 28px/1 var(--serif); }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .ext { color: var(--ink); border-bottom: 1px solid var(--line-2); }
  .ext:hover { border-color: var(--ink); }
  .fc-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; margin-top: 18px; }
  .fc-url { text-transform: none; letter-spacing: .04em; }
  .prose-wrap { max-width: 760px; margin-top: 48px; }
  .back { margin: 56px 0 0; }
  @media (max-width: 720px) {
    .spec { padding-top: 32px; }
    .filecard { padding: 18px; }
    .fc-grid { grid-template-columns: 1fr 1fr; }
    .fc-grid .wide { grid-column: 1 / -1; }
    .fc-actions .btn { flex: 1 1 auto; }
  }
</style>
