  .sky .nm:global(.hot), .sky .nm:focus-visible { color: #fff; text-shadow: 0 0 12px rgba(var(--night-rgb), .95), 0 0 3px rgba(var(--night-rgb), .85), 0 0 14px rgba(255, 255, 255, .6), 0 0 28px rgba(255, 255, 255, .25); }
