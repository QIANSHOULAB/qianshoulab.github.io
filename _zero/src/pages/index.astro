---
// 首页：黑碑。发到 /zero/（根目录换不换看 _zero/home.mjs 那一行）。
// 一望无际的黑水，地平线正中一块碑；光从碑后面慢慢亮起来。碑下半截五撮砖 = 五道门，水上五条铭文各拉一根细线连上去。
// 首屏只有：wordmark、一句话、五条铭文、声音开关（和语言开关）、页脚。three.js 异步加载，黑底和 wordmark 先出来。
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/core/Footer.astro';
import T from '../components/core/T.astro';
import { t, ENTRIES } from '../i18n/ui';
import stillL from '../assets/still-landscape.jpg?url';
import stillP from '../assets/still-portrait.jpg?url';
---
<BaseLayout home>
  <section class="stage" data-stage>
    <div class="gl-host" data-gl-host></div>
    <img class="still" alt="" aria-hidden="true" data-still-l={stillL} data-still-p={stillP} decoding="async" />
    <noscript><img class="still on" src={stillL} alt="" /></noscript>

    <div class="title">
      <h1 class="wm">
        <span class="wm-a" data-l="en" lang="en">ZERO-FLESH CREATION</span><span class="wm-b" data-l="en" lang="zh-CN">零肉身造物</span>
        <span class="wm-a" data-l="zh" lang="zh-CN">零肉身造物</span><span class="wm-b" data-l="zh" lang="en">ZERO-FLESH CREATION</span>
      </h1>
      <T as="p" class="tag" k="home.tagline" />
    </div>

    <svg class="leaders" aria-hidden="true" data-leaders>
      <defs>
        <linearGradient id="ld-fade" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fff" stop-opacity=".42" />
          <stop offset="1" stop-color="#fff" stop-opacity="0" />
        </linearGradient>
      </defs>
      <g class="ld-rest">{ENTRIES.map(() => <line class="ld" x1="0" y1="0" x2="0" y2="0" />)}</g>
      <line class="ld-on" x1="0" y1="0" x2="0" y2="0" />
      <rect class="ld-dot" x="0" y="0" width="7" height="7" />
    </svg>

    <nav class="entries" aria-label={t('en', 'home.entries')} data-aria-en={t('en', 'home.entries')} data-aria-zh={t('zh', 'home.entries')}>
      <ol>
        {ENTRIES.map((e, i) => (
          <li>
            <a class="entry" href={e.href} data-k={i} data-line-en={t('en', `entry.${e.key}.line`)} data-line-zh={t('zh', `entry.${e.key}.line`)}>
              <span class="tick" aria-hidden="true"></span>
              <span class="no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="nm" data-l="en" lang="en" data-text={t('en', `entry.${e.key}.name`)}>{t('en', `entry.${e.key}.name`)}</span>
              <span class="nm" data-l="zh" lang="zh-CN" data-text={t('zh', `entry.${e.key}.name`)}>{t('zh', `entry.${e.key}.name`)}</span>
              <span class="sr"><span data-l="en"> — {t('en', `entry.${e.key}.line`)}</span><span data-l="zh">：{t('zh', `entry.${e.key}.line`)}</span></span>
            </a>
          </li>
        ))}
      </ol>
      <p class="caption" aria-hidden="true"><span class="cap-ink" data-caption></span></p>
    </nav>

    <div class="foot-in"><Footer compact /></div>
  </section>
  <div class="foot-out"><Footer compact /></div>
  <div class="flood" aria-hidden="true" data-flood></div>
</BaseLayout>

<script>
  import '../home/home';
</script>

<style>
  /* 地平线离底边多高（--hzf）、碑占屏高多少（--monof）：画面和文字都按这两个数排，JS 也从这里读 */
  .stage { position: relative; height: 100vh; height: 100svh; min-height: 540px; overflow: hidden; background: #000; --hzf: .40; --monof: .38; --dawn: 0; }
  @media (max-aspect-ratio: 1/1) { .stage { --hzf: .37; --monof: .34; } }
  @media (max-aspect-ratio: 3/4) { .stage { --hzf: .355; --monof: .31; } }
  .gl-host { position: absolute; inset: 0; }
  .gl-host :global(canvas.gl) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; }
  .still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: none; }
  :global(html[data-gl="no"]) .still, .still:global(.on) { display: block; }

  :global(.is-home) :global(.hd) { position: absolute; top: 0; left: 0; right: 0; }

  /* —— 碑顶上那块天：wordmark + 一句话，正中 —— */
  .title { position: absolute; left: 0; right: 0; top: 0; height: calc((1 - var(--hzf) - var(--monof)) * 100%); padding: 44px 16px 0; box-sizing: border-box;
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; pointer-events: none; z-index: 2; }
  .wm { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 12px; font-weight: 500; }
  .wm-a { font: 500 clamp(21px, 2.1vw, 30px)/1 var(--serif); letter-spacing: .46em; padding-left: .46em; color: #f2f2f2; white-space: nowrap; }
  .wm-b { font: 500 12px/1 var(--serif-zh); letter-spacing: 1.1em; padding-left: 1.1em; color: #b9b9b9; }
  :global(html[data-lang="zh"]) .wm-a { font: 500 clamp(24px, 2.4vw, 32px)/1 var(--serif-zh); letter-spacing: .72em; padding-left: .72em; }
  :global(html[data-lang="zh"]) .wm-b { font: 500 11px/1 var(--serif); letter-spacing: .5em; padding-left: .5em; }
  .title :global(.tag) { margin: 18px 0 0; font: 400 11.5px/1.4 var(--mono); letter-spacing: .14em; color: #d2d2d2; text-shadow: 0 0 18px rgba(0, 0, 0, .55); }
  :global(html[data-lang="zh"]) .title :global(.tag) { font: 500 13px/1.4 var(--serif-zh); letter-spacing: .36em; padding-left: .36em; }

  /* —— 水上那五条铭文：一排，左右对称；每条头上一根小桩，细线从这里升到碑上那撮 —— */
  .leaders { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; overflow: visible; opacity: calc(.1 + var(--dawn) * .9); transition: opacity .6s linear; }
  .ld { stroke: url(#ld-fade); stroke-width: 1; vector-effect: non-scaling-stroke; transition: opacity .5s var(--ease); }
  .leaders:global(.has-on) .ld { opacity: .35; }
  .ld-on { stroke: #fff; stroke-width: 1; stroke-opacity: .85; opacity: 0; transition: opacity .3s var(--ease); }
  .ld-dot { fill: none; stroke: #fff; stroke-width: 1; opacity: 0; transition: opacity .4s var(--ease); }
  .leaders:global(.has-on) .ld-on, .leaders:global(.has-on) .ld-dot { opacity: 1; }

  .entries { position: absolute; left: 0; right: 0; top: calc((1 - var(--hzf)) * 100% + var(--egap)); z-index: 3; --egap: clamp(52px, 12vh, 132px);
    opacity: calc(.18 + var(--dawn) * .82); transition: opacity .6s linear; }
  /* 五列一样宽：正中那条正好在中轴上，左右镜像 */
  .entries ol { list-style: none; margin: 0 auto; padding: 0 16px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); justify-items: center; align-items: start; max-width: min(1080px, 100%); box-sizing: border-box; }
  .entries li { display: flex; justify-content: center; min-width: 0; }
  .entry { position: relative; display: flex; flex-direction: column; align-items: center; gap: 9px; padding: 0 2px 6px; color: #b4b4b4; text-shadow: 0 0 14px rgba(0, 0, 0, .8), 0 0 3px rgba(0, 0, 0, .7); transition: color .35s var(--ease); }
  /* 字底下一小团暗：水上的字不被光路冲掉 */
  .entry::before { content: ""; position: absolute; left: -22px; right: -22px; top: 14px; bottom: -14px; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgba(0, 0, 0, .5), rgba(0, 0, 0, 0)); }
  /* 正中那条踩在光路上：底下的暗再重一点 */
  .entries li:nth-child(3) .entry::before { left: -30px; right: -30px; top: 0; background: radial-gradient(closest-side, rgba(0, 0, 0, .72), rgba(0, 0, 0, 0)); }
  .tick { width: 1px; height: 18px; background: currentColor; opacity: .55; transform-origin: 50% 100%; transition: opacity .35s var(--ease), transform .5s var(--ease); }
  .no { font: 400 10.5px/1 var(--mono); letter-spacing: .16em; padding-left: .16em; color: #9a9a9a; transition: color .35s var(--ease); }
  .nm { font: 500 15px/1.2 var(--serif); letter-spacing: .28em; padding-left: .28em; white-space: nowrap; }
  :global(html[data-lang="zh"]) .nm { font: 500 15px/1.2 var(--serif-zh); letter-spacing: .4em; padding-left: .4em; }
  .entry:global(.on), .entry:hover, .entry:focus-visible { color: #fff; }
  .entry:global(.on) .tick { opacity: 1; transform: scaleY(1.5); }
  .entry:global(.on) .no { color: #d0d0d0; }
  .entry:focus-visible { outline: none; }
  .entry:focus-visible .nm { outline: 1px solid #fff; outline-offset: 6px; }
  /* 一个字一个字写出来 */
  .nm :global(.lt) { opacity: 0; animation: ink .42s var(--ease) forwards; }
  .caption { margin: 26px 0 0; min-height: 20px; text-align: center; font: 400 12px/20px var(--mono); letter-spacing: .08em; color: #c9c9c9; padding: 0 16px; text-shadow: 0 0 12px rgba(0, 0, 0, .8); }
  :global(html[data-lang="zh"]) .caption { font: 500 14px/20px var(--serif-zh); letter-spacing: .3em; }
  .caption :global(.lt) { opacity: 0; animation: ink .5s var(--ease) forwards; }
  .caption:global(.out) { opacity: 0; transition: opacity .3s var(--ease); }
  @keyframes ink { from { opacity: 0; } to { opacity: 1; } }

  /* —— 页脚：电脑上压在首屏底边；手机放在首屏下面，往下滑才看到 —— */
  .foot-in { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; padding-top: 48px; background: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, .62)); }
  .foot-in :global(.ft) { padding: 0 24px 20px; }
  .foot-in :global(.ft-co) { font-size: 12px; color: #8a8a8a; }
  .foot-in :global(.ft-co .ft-name) { font-size: 12px; color: #bdbdbd; }
  .foot-in :global(.ft-addr) { font-size: 10.5px; color: #626262; margin-top: 4px !important; }
  .foot-out { display: none; }

  .flood { position: fixed; inset: 0; background: #fff; opacity: 0; pointer-events: none; z-index: 90; }

  @media (max-width: 760px), (max-height: 620px) {
    .foot-in { display: none; }
    .foot-out { display: block; background: #000; }
    .foot-out :global(.ft) { padding: 32px 20px 40px; }
  }
  @media (max-width: 760px) {
    .wm { gap: 10px; }
    .wm-a { font-size: 18px; letter-spacing: .34em; padding-left: .34em; }
    :global(html[data-lang="zh"]) .wm-a { font-size: 24px; letter-spacing: .6em; padding-left: .6em; }
    .title :global(.tag) { font-size: 11px; letter-spacing: .08em; margin-top: 14px; }
    .entries { --egap: clamp(30px, 6.5vh, 64px); }
    /* 手机：一排放不下五条，错成两排——01 03 05 在上，02 04 往下错半格（之字形，还是左右对称，线也不交叉） */
    .entries ol { padding: 0 6px; max-width: 460px; }
    .entries li:nth-child(odd) { transform: translateY(var(--zig)); }
    .entries { --zig: 50px; }
    .entry { gap: 7px; }
    .tick { height: 14px; }
    .nm { font-size: 11.5px; letter-spacing: .12em; padding-left: .12em; white-space: normal; width: min-content; text-align: center; line-height: 1.4; }
    :global(html[data-lang="zh"]) .nm { font-size: 14px; letter-spacing: .24em; padding-left: .24em; width: auto; white-space: nowrap; }
    :global(html[data-lang="zh"]) .entries { --zig: 40px; }
    .caption { margin-top: calc(var(--zig) + 14px); font-size: 11px; letter-spacing: .04em; }
    :global(html[data-lang="zh"]) .caption { font-size: 13px; letter-spacing: .16em; }
  }

  /* 截静态图用：?still 只留画面 */
  :global(html[data-still]) .title, :global(html[data-still]) .entries, :global(html[data-still]) .leaders, :global(html[data-still]) .foot-in,
  :global(html[data-still]) :global(.hd) { visibility: hidden; }
  :global(html[data-gl="no"]) .leaders { display: none; }
  /* 底边压暗一点：倒影的尽头、页脚都落在暗处 */
  .stage::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 22%; pointer-events: none; z-index: 1;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, .55)); }
</style>
