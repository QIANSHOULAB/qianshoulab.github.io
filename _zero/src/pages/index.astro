---
// 首页：造物之门。发到 /zero/（根目录换不换看 _zero/home.mjs 那一行）。
// 画布固定铺满，往下滑是在创世：七幕，全程跟手，倒着滑会倒放。画面跟着滚动走，字跟着画面走。
// v3.1（Song 11-28）：画面上只留名字。首屏一个 wordmark 和一个很小的往下滑提示；第二到第六幕只有栏目名和「进去」；
// 第七幕「开天」只有那句话、五个栏目名和页脚。读屏读到的、没有 WebGL 时的静态图上压的，也只有这些字。
// three.js 异步加载，黑底和 wordmark 先出来，3D 后到。
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/core/T.astro';
import { t, ENTRIES } from '../i18n/ui';
import { shop } from '../data/tools';
import { SCROLL, SECTION_HEX } from '../scene/tune';
// 七幕各一张静态图（scripts/stills.mjs 截的）：没有 WebGL 时首页用它们
const stillMods = import.meta.glob('../assets/stills/*.jpg', { eager: true, query: '?url', import: 'default' }) as Record<string, string>;
const still = (k: number, o: 'l' | 'p') => stillMods[`../assets/stills/act${k}-${o}.jpg`];

const ACTS = ENTRIES.map((e, i) => ({ ...e, k: i + 2, hex: SECTION_HEX[i] }));
const units = SCROLL.hold + SCROLL.acts.reduce((a, b) => a + b, 0) + SCROLL.tail + 1;
const chars = (s: string) => [...s].map((c, i) => ({ c, i }));
const mail = ['oilsongchengmin', 'gmail.com'].join('@');
const SEVEN = [1, 2, 3, 4, 5, 6, 7];
const stills = { l: SEVEN.map((k) => still(k, 'l')), p: SEVEN.map((k) => still(k, 'p')) };
const nm = (l: 'en' | 'zh', key: string) => t(l, `entry.${key}.name`);
// 那句话拆成两半（各自不断行）：屏宽放得下就一行，放不下就从句号 / 逗号那儿换行，不会断在「把肉身」后面
const motto = { en: t('en', 'company.motto').replace(/^—\s*/, ''), zh: t('zh', 'company.motto').replace(/^——/, '') };
const halves = (s: string) => { const m = /^(.+?[.，])\s*(.+)$/.exec(s); return m ? [m[1], m[2]] : [s]; };
// 右边七个刻度没有字；读屏念的是它通到哪：首屏念 wordmark，第二到第六幕念栏目名，第七幕念「五个入口」
const tickName = (l: 'en' | 'zh', k: number) => (k === 1 ? (l === 'en' ? 'Zero-Flesh Creation' : '零肉身造物') : k === 7 ? t(l, 'acts.doors') : nm(l, ENTRIES[k - 2].key));
---
<BaseLayout home>
  <div class="stage" data-stage data-moons={shop.length} aria-hidden="true">
    <div class="gl-host" data-gl-host></div>
    <img class="still" alt="" data-stills={JSON.stringify(stills)} decoding="async" />
    <noscript><img class="still on" src={still(1, 'l')} alt="" /></noscript>
  </div>

  <div class="ui" data-ui>
    <section class="hero" data-hero aria-labelledby="h-hero">
      <div class="title">
        <h1 class="wm" id="h-hero">
          <span class="wm-a" data-l="en" lang="en">ZERO-FLESH CREATION</span><span class="wm-b" data-l="en" lang="zh-CN">零肉身造物</span>
          <span class="wm-a" data-l="zh" lang="zh-CN">零肉身造物</span><span class="wm-b" data-l="zh" lang="en">ZERO-FLESH CREATION</span>
        </h1>
      </div>
      <p class="hint" aria-hidden="true"><T k="acts.hint" /><span class="hint-line"></span></p>
    </section>

    {ACTS.map((a) => (
      <section class="act" data-act={a.k} style={`--c:${a.hex}`} aria-labelledby={`h-act${a.k}`}>
        <div class="card">
          <h2 class="act-name" id={`h-act${a.k}`}>
            <span data-l="en" lang="en"><span class="sr">{nm('en', a.key)}</span><span class="chs" aria-hidden="true">{chars(nm('en', a.key)).map(({ c, i }) => <span class="ch" style={`--i:${i}`}>{c}</span>)}</span></span>
            <span data-l="zh" lang="zh-CN"><span class="sr">{nm('zh', a.key)}</span><span class="chs" aria-hidden="true">{chars(nm('zh', a.key)).map(({ c, i }) => <span class="ch" style={`--i:${i}`}>{c}</span>)}</span></span>
          </h2>
          <a class="go" href={a.href} data-go={a.k} id={`go${a.k}`} aria-labelledby={`go${a.k} h-act${a.k}`}><T k="acts.enter" /><span class="arr" aria-hidden="true">→</span></a>
        </div>
      </section>
    ))}

    <section class="act act7" data-act="7" aria-labelledby="h-act7">
      <div class="end" data-end>
        <h2 class="motto" id="h-act7">
          <span data-l="en" lang="en">{halves(motto.en).map((h, i) => <>{i > 0 && ' '}<span class="mh">{h}</span></>)}</span>
          <span data-l="zh" lang="zh-CN">{halves(motto.zh).map((h) => <span class="mh">{h}</span>)}</span>
        </h2>
        <nav class="links" aria-label={t('en', 'acts.doors')} data-aria-en={t('en', 'acts.doors')} data-aria-zh={t('zh', 'acts.doors')}>
          {ENTRIES.map((e, i) => (
            <a href={e.href} data-end-go={i} style={`--c:${SECTION_HEX[i]}`}><T k={`entry.${e.key}.name`} /></a>
          ))}
        </nav>
      </div>
      <div class="foot" data-foot>
        <p class="co"><span class="co-nm" lang="zh-CN">零肉身造物 | Zero-Flesh Creation</span> <T k="company.p1" /></p>
        <T as="p" class="addr" k="company.addr" />
        <p class="mail"><a href={`mailto:${mail}?subject=${encodeURIComponent('零肉身造物 · Zero-Flesh Creation')}`} title={mail}><T k="foot.mail" /></a></p>
      </div>
    </section>
  </div>

  <nav class="ticks" aria-label={t('en', 'acts.label')} data-aria-en={t('en', 'acts.label')} data-aria-zh={t('zh', 'acts.label')} data-ticks>
    {SEVEN.map((k) => (
      <button type="button" data-tick={k} aria-label={tickName('en', k)} data-aria-en={tickName('en', k)} data-aria-zh={tickName('zh', k)}>
        <span class="tk-m" aria-hidden="true"></span>
      </button>
    ))}
  </nav>

  <div class="track" aria-hidden="true" style={`--units:${units}`}></div>
  <div class="flood" aria-hidden="true" data-flood></div>
</BaseLayout>

<script>
  import '../home/home';
</script>

<style>
  /* 画布和字都固定铺满一屏（用最大视口高：iPhone 地址栏收放时不跳）；往下滑的长度由 .track 撑出来 */
  .stage, .ui { position: fixed; left: 0; top: 0; width: 100%; height: 100vh; height: 100lvh; --hzf: .40; --monof: .38; }
  @media (max-aspect-ratio: 1/1) { .stage, .ui { --hzf: .37; --monof: .34; } }
  @media (max-aspect-ratio: 3/4) { .stage, .ui { --hzf: .355; --monof: .31; } }
  .stage { z-index: 0; background: #000; overflow: hidden; }
  .gl-host { position: absolute; inset: 0; }
  .gl-host :global(canvas.gl) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: none; transition: opacity .6s var(--ease); }
  :global(html[data-gl="no"]) .still, .still:global(.on) { display: block; }
  .gl-host::after { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: var(--grain); background-size: 160px 160px; opacity: .045; mix-blend-mode: screen; }
  .ui { z-index: 5; pointer-events: none; }
  .track { position: relative; height: calc(var(--units) * 100vh); height: calc(var(--units) * 100lvh); }
  :global(.is-home) :global(.hd) { position: fixed; top: 0; left: 0; right: 0; z-index: 30; transition: opacity .5s var(--ease); }
  :global(html[data-scrolled]) :global(.is-home) :global(.hd) { opacity: .72; }

  /* —— 一个字一个字写出来：.on 的时候按 --i 依次亮；退的时候一起退 —— */
  .chs :global(.ch) { opacity: 0; transition: opacity .18s var(--ease); }
  .act:global(.on) .card .chs :global(.ch) { opacity: 1; transition: opacity .45s var(--ease) calc(var(--i) * 34ms); }
  .chs { white-space: pre; }

  /* —— 首屏：只有 wordmark（门顶上那块天）和最底下一个很小的往下滑提示 —— */
  .hero { position: absolute; inset: 0; transition: opacity .7s var(--ease); }
  .hero:not(:global(.on)) { opacity: 0; }
  .title { position: absolute; left: 0; right: 0; top: 0; height: calc((1 - var(--hzf) - var(--monof)) * 100%); padding: 44px 16px 0; box-sizing: border-box;
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  .wm { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 12px; font-weight: 500; }
  .wm-a { font: 500 clamp(21px, 2.1vw, 30px)/1 var(--serif); letter-spacing: .46em; padding-left: .46em; color: #f2f2f2; white-space: nowrap; }
  .wm-b { font: 500 12px/1 var(--serif-zh); letter-spacing: 1.1em; padding-left: 1.1em; color: #b9b9b9; }
  :global(html[data-lang="zh"]) .wm-a { font: 500 clamp(24px, 2.4vw, 32px)/1 var(--serif-zh); letter-spacing: .72em; padding-left: .72em; }
  :global(html[data-lang="zh"]) .wm-b { font: 500 11px/1 var(--serif); letter-spacing: .5em; padding-left: .5em; }
  .hint { position: absolute; left: 0; right: 0; bottom: 26px; margin: 0; display: flex; flex-direction: column; align-items: center; gap: 9px;
    font: 400 9px/1 var(--mono); letter-spacing: .32em; padding-left: .32em; text-transform: uppercase; color: #7c7c7c; }
  :global(html[data-lang="zh"]) .hint { font: 500 10px/1 var(--serif-zh); letter-spacing: .5em; padding-left: .5em; }
  /* 提示正压在门的那条光路上：底下垫一小团暗，字才看得清 */
  .hint::before { content: ""; position: absolute; left: 50%; top: -16px; width: 150px; height: 64px; transform: translateX(-50%); z-index: -1;
    background: radial-gradient(closest-side, rgba(0, 0, 0, .78), rgba(0, 0, 0, 0)); }
  .hint-line { width: 1px; height: 26px; background: linear-gradient(#fff, rgba(255, 255, 255, 0)); opacity: .5; transform-origin: 50% 0; animation: drip 2.6s var(--slow) infinite; }
  @keyframes drip { 0% { transform: scaleY(0); opacity: 0; } 30% { opacity: .6; } 100% { transform: scaleY(1); opacity: 0; } }

  /* —— 第二到第六幕：造好了才出名字（大字，一个字一个字写出来），下面一个「进去」 —— */
  .act { position: absolute; inset: 0; }
  .card { position: absolute; left: max(24px, 6.5vw); bottom: max(9vh, 60px); width: min(560px, calc(100% - 48px)); padding: 0; transition: opacity .5s var(--ease); }
  .card::before { content: ""; position: absolute; left: -60px; right: -40px; top: -40px; bottom: -36px; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgba(0, 0, 0, .55), rgba(0, 0, 0, 0)); }
  .act:not(:global(.on)) .card { opacity: 0; }
  .act:not(:global(.on)) .card .go { pointer-events: none; }
  .act-name { margin: 0 0 22px; font: 500 clamp(30px, 3.4vw, 44px)/1.1 var(--serif); letter-spacing: .3em; color: #f4f4f4; text-shadow: 0 0 24px rgba(0, 0, 0, .7); }
  :global(html[data-lang="zh"]) .act-name { font-family: var(--serif-zh); letter-spacing: .5em; }
  .go { pointer-events: auto; display: inline-flex; align-items: center; gap: 12px; padding: 10px 0; font: 400 11.5px/1 var(--mono); letter-spacing: .24em; text-transform: uppercase; color: #fff; border-bottom: 1px solid rgba(255, 255, 255, .35); transition: border-color .3s var(--ease), gap .3s var(--ease); }
  :global(html[data-lang="zh"]) .go { font: 500 14px/1 var(--serif-zh); letter-spacing: .4em; }
  .go:hover, .go:focus-visible { border-color: #fff; gap: 18px; }
  .go .arr { font-family: var(--mono); letter-spacing: 0; }

  /* —— 第七幕「开天」：那句话在星空里慢慢亮起来，下面一排五个栏目名；页脚在最下面。
     位置跟画面对好了：字压在星云中间那块相对暗的地方（genesis.ts 读 .end 的位置，把那一块天留暗），页脚落在水面那面镜子上 —— */
  .act7 { --end-y: 58%; }
  .act7 .end { position: absolute; left: 50%; top: var(--end-y); transform: translate(-50%, -50%); width: min(980px, calc(100% - 40px)); text-align: center; }
  .act7 .end::before { content: ""; position: absolute; left: -6%; right: -6%; top: -70%; bottom: -60%; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgba(0, 0, 0, .42), rgba(0, 0, 0, .16) 62%, rgba(0, 0, 0, 0)); opacity: 0; transition: opacity 2.4s var(--ease); }
  .motto { margin: 0 0 30px; font: 500 clamp(20px, 2.15vw, 30px)/1.45 var(--serif); letter-spacing: .08em; color: #fff;
    text-shadow: 0 0 2px rgba(0, 0, 0, .5), 0 0 26px rgba(0, 0, 0, .75), 0 0 60px rgba(0, 0, 0, .5);
    opacity: 0; filter: blur(6px); transition: opacity 2.4s var(--slow), filter 2.4s var(--slow); }
  :global(html[data-lang="zh"]) .motto { font-family: var(--serif-zh); letter-spacing: .22em; padding-left: .22em; }
  .mh { display: inline-block; }
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 34px; margin: 0; opacity: 0; transform: translateY(6px); transition: opacity 1.2s var(--ease) .9s, transform 1.2s var(--ease) .9s; }
  .links a { pointer-events: auto; font: 500 13.5px/1 var(--serif); letter-spacing: .24em; padding: 9px 0 9px .24em; color: #e2e2e2; border-bottom: 1px solid transparent;
    text-shadow: 0 0 14px rgba(0, 0, 0, .85), 0 0 3px rgba(0, 0, 0, .6); transition: color .3s var(--ease), border-color .3s var(--ease); }
  :global(html[data-lang="zh"]) .links a { font: 500 14px/1 var(--serif-zh); letter-spacing: .36em; padding-left: .36em; }
  .links a:hover, .links a:focus-visible { color: #fff; border-color: var(--c); }
  .act7 .foot { position: absolute; left: 50%; bottom: max(4vh, 22px); transform: translateX(-50%); width: min(820px, calc(100% - 40px)); text-align: center;
    opacity: 0; transition: opacity 1.4s var(--ease) 1.4s; }
  .act7 .foot::before { content: ""; position: absolute; left: -10%; right: -10%; top: -40%; bottom: -30%; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgba(0, 0, 0, .55), rgba(0, 0, 0, 0)); }
  .act7:global(.on) .end::before { opacity: 1; }
  .act7:global(.on) .motto { opacity: 1; filter: none; }
  .act7:global(.on) .links { opacity: 1; transform: none; }
  .act7:global(.on) .foot { opacity: 1; }
  .act7:not(:global(.on)) a { pointer-events: none; }
  .act7:not(:global(.on)) .links, .act7:not(:global(.on)) .foot, .act7:not(:global(.on)) .end::before { transition-delay: 0s; transition-duration: .5s; }
  .act7:not(:global(.on)) .motto { transition-duration: .7s; }
  .co { margin: 0 0 6px; font-size: 13px; line-height: 1.6; color: #b9b9b9; text-shadow: 0 0 10px rgba(0, 0, 0, .9); }
  .co-nm { font: 500 13px/1 var(--serif); letter-spacing: .16em; color: #ececec; margin-right: 8px; white-space: nowrap; }
  .act7 .foot :global(.addr) { margin: 0 auto 14px; max-width: 760px; font: 400 10.5px/1.75 var(--mono); letter-spacing: .02em; color: #969696; text-shadow: 0 0 8px rgba(0, 0, 0, .95); }
  .mail { margin: 0; font: 400 11px/1 var(--mono); letter-spacing: .12em; }
  .mail a { pointer-events: auto; color: #c4c4c4; border-bottom: 1px solid rgba(255, 255, 255, .3); padding-bottom: 3px; }

  /* —— 右边一列七个小刻度（不写字；滑到哪幕哪个亮，点了跳到那幕） —— */
  .ticks { position: fixed; right: max(12px, 1.5vw); top: 50%; transform: translateY(-50%); z-index: 20; display: flex; flex-direction: column; gap: 4px; transition: opacity .6s var(--ease); }
  .ticks button { all: unset; cursor: pointer; display: flex; align-items: center; justify-content: flex-end; padding: 6px 2px 6px 10px; color: #8a8a8a; }
  .tk-m { width: 12px; height: 1px; background: currentColor; transition: width .35s var(--ease), background-color .35s var(--ease); }
  .ticks button:global(.on) { color: #fff; }
  .ticks button:global(.on) .tk-m { width: 26px; }
  .ticks button:hover .tk-m { width: 20px; }
  .ticks button:focus-visible { outline: 1px solid #fff; outline-offset: 2px; }
  :global(html[data-opening]) .ticks { opacity: 0; pointer-events: none; }

  /* 第七幕天最亮的时候，顶栏底下垫一层很淡的暗，EN / 中文、SOUND 照样看得清 */
  .ui::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 92px; pointer-events: none; opacity: 0; transition: opacity 1s var(--ease);
    background: linear-gradient(rgba(0, 0, 0, .5), rgba(0, 0, 0, 0)); }
  :global(html[data-sky]) .ui::before { opacity: 1; }

  .flood { position: fixed; inset: 0; background: #fff; opacity: 0; pointer-events: none; z-index: 90; }
  :global(html[data-diving]) .ui, :global(html[data-diving]) .ticks, :global(html[data-diving]) :global(.hd) { opacity: 0 !important; transition: opacity .4s var(--ease); }

  /* —— 手机竖着：字在下三分之一；最底下 90 像素不放要看、要点的东西（iOS 26 浮动工具栏会盖住）—— */
  @media (max-width: 760px) {
    .wm { gap: 10px; }
    .wm-a { font-size: 18px; letter-spacing: .34em; padding-left: .34em; }
    :global(html[data-lang="zh"]) .wm-a { font-size: 24px; letter-spacing: .6em; padding-left: .6em; }
    .hint { bottom: calc(env(safe-area-inset-bottom, 0px) + 100px); }
    .card { left: 22px; right: 22px; width: auto; bottom: calc(env(safe-area-inset-bottom, 0px) + 104px); }
    .act-name { font-size: 30px; margin-bottom: 16px; letter-spacing: .2em; }
    :global(html[data-lang="zh"]) .act-name { letter-spacing: .4em; }
    .act7 { --end-y: 60%; }
    .act7 .end { width: calc(100% - 64px); }
    .motto { font-size: 19px; margin-bottom: 20px; }
    :global(html[data-lang="zh"]) .motto { font-size: 18px; letter-spacing: .16em; padding-left: .16em; }
    .links { gap: 0 22px; max-width: 330px; margin: 0 auto; }
    .links a { font-size: 12px; padding: 8px 0 8px .24em; }
    :global(html[data-lang="zh"]) .links a { font-size: 13px; }
    .act7 .foot { bottom: calc(env(safe-area-inset-bottom, 0px) + 92px); }
    .co { font-size: 11.5px; }
    .co-nm { font-size: 12px; }
    .act7 .foot :global(.addr) { font-size: 9.5px; line-height: 1.6; margin-bottom: 12px; }
    .ticks { right: 6px; gap: 0; }
    .ticks button { padding: 5px 2px 5px 8px; }
    .tk-m { width: 8px; }
    .ticks button:global(.on) .tk-m { width: 16px; }
  }
  @media (max-height: 560px) and (min-aspect-ratio: 3/2) {
    /* 手机横着：造物缩小，字只留名字和「进去」 */
    .act-name { font-size: 24px; margin-bottom: 8px; }
    .card { bottom: 20px; }
    .act7 { --end-y: 57%; }
    .act7 .foot :global(.addr), .co { display: none; }
    .act7 .foot { bottom: 12px; }
    .motto { margin-bottom: 10px; }
    .hint { bottom: 14px; }
  }

  /* 截静态图用：?still 只留画面 */
  :global(html[data-still]) .ui, :global(html[data-still]) .ticks, :global(html[data-still]) :global(.hd) { visibility: hidden; }
  @media (prefers-reduced-motion: reduce) {
    .chs :global(.ch) { transition: none !important; }
    .motto, .links, .act7 .foot, .act7 .end::before { transition: none !important; }
    .hint-line { animation: none; opacity: .4; }
  }
</style>
