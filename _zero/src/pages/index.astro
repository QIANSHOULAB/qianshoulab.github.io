---
// 观测台（首页）：宣言 + 实时几何取景框 + 两扇门（千手院、赛博炸货铺）+ 三个抽屉 + 最新归档时间流。
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/core/T.astro';
import { tAny } from '../i18n/ui';
import { monks, fryShop } from '../data/tools';
import { pairs, updates } from '../utils/archive';
import { SPECIES } from '../data/species';

const specimens = await pairs('specimens');
const artifacts = await pairs('artifacts');
const codex = await pairs('codex');
const ups = await updates();
const rules = { en: tAny<string[][]>('en', 'home.manifesto.rules'), zh: tAny<string[][]>('zh', 'home.manifesto.rules') };
const first = SPECIES[0];
const pin = (s: string) => s.split(' · ')[0];
const cols = [
  { key: 'specimens', path: '/specimens', latest: specimens[0] && { tag: specimens[0].en.data.id, en: specimens[0].en.data.title, zh: specimens[0].zh.data.title, live: true } },
  { key: 'artifacts', path: '/artifacts', latest: artifacts[0] && { tag: artifacts[0].en.data.id, en: artifacts[0].en.data.title, zh: artifacts[0].zh.data.title, live: artifacts[0].en.data.status === 'live' } },
  { key: 'codex', path: '/codex', latest: codex[0] && { tag: codex[0].en.data.id, en: codex[0].en.data.title, zh: codex[0].zh.data.title, live: codex[0].en.data.status === 'live' } },
];
const kinds = [['specimen', 'specimens'], ['artifact', 'artifacts'], ['codex', 'codex']] as const;
---
<BaseLayout current="home">
  <section class="hero wrap">
    <div class="hero-text">
      <p class="kicker mono"><span class="dot" aria-hidden="true"></span><span>/</span><T k="home.kicker" /></p>
      <h1 class="h1"><T k="home.h1" /></h1>
      <T as="p" class="lede" k="home.lede" />
    </div>
    <figure class="viewport card" data-hero>
      <div class="stage" data-stage></div>
      <div class="ticks" aria-hidden="true"></div>
      <div class="hud tl mono" data-noscan aria-hidden="true"><T k="home.vp.name" /></div>
      <div class="hud tr mono" data-noscan aria-hidden="true"><span data-hud="fps">–</span> fps<span class="wide-only"> · <span data-hud="verts">1,200</span> verts</span></div>
      <div class="hud bl" data-noscan>
        <span class="mono hud-k"><T k="home.vp.species" /></span>
        <span class="latin" data-hud="latin">{first.latin}</span>
        <span class="common"><span data-hud="common" data-l="en" lang="en">{first.en}</span><span data-hud="common" data-l="zh" lang="zh-CN">{first.zh}</span></span>
      </div>
      <div class="hud br mono render-only" data-noscan aria-hidden="true"><T k="home.vp.drag" /></div>
      <figcaption class="formula mono" data-noscan>
        <span>r(φ) = ( |cos(m·φ/4)|<sup>n₂</sup> + |sin(m·φ/4)|<sup>n₃</sup> )<sup>−1/n₁</sup></span>
        <span class="params" data-hud="params"></span>
      </figcaption>
    </figure>
  </section>

  <nav class="doors wrap" aria-label="QIANSHOU LAB · Cyber Fry Shop">
    <a class="door card link-card" href="/qianshou/" data-sfx="open">
      <div class="door-art" data-emblem="halo"></div>
      <div class="door-body">
        <p class="door-path mono">/qianshou</p>
        <h2 class="door-name"><T k="home.qianshou.name" /><span class="door-alt"><T k="home.qianshou.alt" /></span></h2>
        <T as="p" class="door-sub" k="home.qianshou.sub" />
        <p class="door-meta"><T k="home.qianshou.meta" /></p>
        <p class="door-list mono" aria-hidden="true">
          <span data-l="en" lang="en">{monks.map((m) => pin(m.name.en)).join(' · ')}</span>
          <span data-l="zh" lang="zh-CN">{monks.map((m) => m.name.zh).join(' · ')}</span>
        </p>
        <span class="go"><T k="home.qianshou.go" /> <span class="arr" aria-hidden="true">→</span></span>
      </div>
    </a>
    <a class="door card link-card" href="/zhahuopu/" data-sfx="open">
      <div class="door-art" data-emblem="mahua"></div>
      <div class="door-body">
        <p class="door-path mono">/zhahuopu</p>
        <h2 class="door-name"><T k="home.zhahuopu.name" /><span class="door-alt"><T k="home.zhahuopu.alt" /></span></h2>
        <T as="p" class="door-sub" k="home.zhahuopu.sub" />
        <p class="door-meta"><T k="home.zhahuopu.meta" vars={{ n: fryShop.length }} /></p>
        <p class="door-list mono" aria-hidden="true">
          <span data-l="en" lang="en">{fryShop.map((m) => pin(m.name.en)).join(' · ')}</span>
          <span data-l="zh" lang="zh-CN">{fryShop.map((m) => m.name.zh).join(' · ')}</span>
        </p>
        <span class="go"><T k="home.zhahuopu.go" /> <span class="arr" aria-hidden="true">→</span></span>
      </div>
    </a>
  </nav>

  <section class="sec wrap" aria-labelledby="lab-t">
    <div class="sec-h"><span class="sec-no">§01</span><h2 class="sec-t" id="lab-t"><T k="home.lab.t" /></h2></div>
    <T as="p" class="sec-sub" k="home.lab.sub" />
    <div class="cols">
      {cols.map((c) => (
        <a class="col card link-card" href={`${c.path}/`} data-sfx="tick">
          <p class="col-path mono">{c.path}</p>
          <h3 class="col-name"><T k={`cols.${c.key}.name`} /></h3>
          <T as="p" class="col-desc" k={`cols.${c.key}.desc`} />
          <div class="col-foot">
            {c.latest ? (
              <>
                <span class={`chip ${c.latest.live ? 'live' : 'wip'}`}>{c.latest.tag}</span>
                <span class="col-latest"><T en={c.latest.en} zh={c.latest.zh} /></span>
                {!c.latest.live && <span class="chip wip"><T k="status.wip" /></span>}
              </>
            ) : (
              <span class="chip wip"><T k="cols.none" /></span>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="sec wrap" aria-labelledby="latest-t">
    <div class="sec-h latest-h">
      <span class="sec-no">§02</span><h2 class="sec-t" id="latest-t"><T k="home.latest.t" /></h2>
      <div class="seg filters" role="group" aria-label="Filter">
        <button type="button" data-f="all" aria-pressed="true" data-sfx="tick"><T k="home.latest.all" /></button>
        {kinds.map(([k, col]) => <button type="button" data-f={k} aria-pressed="false" data-sfx="tick"><T k={`cols.${col}.name`} /></button>)}
      </div>
    </div>
    <ol class="stream">
      {ups.map((u) => (
        <li data-kind={u.kind}>
          <a class="row" href={u.href} data-sfx="tick">
            <time class="mono when" datetime={u.date}>{u.date}</time>
            <span class={`chip kind k-${u.kind}`}>{u.kind === 'specimen' ? <><T k="kind.specimen" />{'\u00a0·\u00a0'}{u.tag}</> : u.tag ? u.tag : <T k={`kind.${u.kind}`} />}</span>
            <span class="what">
              <T class="row-t" en={u.title.en} zh={u.title.zh} />
              <T as="span" class="row-s" en={u.summary.en} zh={u.summary.zh} />
            </span>
            <span class="arr" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
    <T as="p" class="empty" k="home.latest.empty" />
  </section>

  <section class="sec wrap" aria-labelledby="mani-t">
    <div class="sec-h"><span class="sec-no">§03</span><h2 class="sec-t" id="mani-t"><T k="home.manifesto.t" /></h2></div>
    <div class="mani">
      <dl class="rules card">
        {rules.en.map((r, i) => (
          <div class="rule">
            <dt class="mono"><span data-l="en" lang="en">{r[0]}</span><span data-l="zh" lang="zh-CN">{rules.zh[i][0]}</span></dt>
            <dd><span data-l="en" lang="en">{r[1]}</span><span data-l="zh" lang="zh-CN">{rules.zh[i][1]}</span></dd>
          </div>
        ))}
      </dl>
      <div class="mani-side">
        <blockquote class="quote"><T k="home.manifesto.quote" /></blockquote>
        <T as="p" class="principle" k="home.manifesto.principle" />
        <div class="company card">
          <p class="company-h" lang="zh-CN">{'零肉身造物 | Zero-Flesh Creation'}</p>
          <T as="p" class="company-p" k="company.p1" />
          <T as="p" class="company-motto" k="company.motto" />
          <T as="p" class="company-addr" k="company.addr" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { mountHero } from '../components/core/HeroCanvas';
  import { mountEmblems } from '../components/labs/emblems';
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) mountHero(hero);
  mountEmblems();

  // 时间流筛选：全部 / 样本 / 自研 / 法则
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.filters button'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.stream li'));
  const empty = document.querySelectorAll<HTMLElement>('.empty');
  function apply(f: string) {
    let n = 0;
    rows.forEach((r) => { const on = f === 'all' || r.dataset.kind === f; r.hidden = !on; if (on) n++; });
    btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.f === f)));
    empty.forEach((e) => e.classList.toggle('show', n === 0));
  }
  btns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.f || 'all')));
</script>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; align-items: center; padding-top: 72px; padding-bottom: 32px; }
  .kicker { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--dim); margin: 0 0 20px; letter-spacing: .02em; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--signal); box-shadow: 0 0 10px var(--signal); animation: pulse 2.4s var(--ease) infinite; }
  @keyframes pulse { 50% { opacity: .35; } }
  .h1 { font-size: clamp(40px, 5.4vw, 64px); line-height: 1.06; font-weight: 700; letter-spacing: -.025em; margin: 0 0 20px; text-wrap: balance; }
  :global(html[data-lang="zh"]) .h1 { letter-spacing: 0; line-height: 1.15; }
  .hero :global(.lede) { font-size: 19px; line-height: 1.55; color: var(--dim); margin: 0; max-width: 34em; text-wrap: pretty; }

  .viewport { margin: 0; aspect-ratio: 7 / 5.2; overflow: hidden; background: radial-gradient(120% 90% at 50% 45%, #10161A 0%, #0C0E11 60%, #0A0B0D 100%); display: flex; flex-direction: column; }
  .stage { position: relative; flex: 1; min-height: 0; }
  .stage :global(.hero-canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; cursor: grab; }
  .stage :global(.hero-canvas:active) { cursor: grabbing; }
  .hud { position: absolute; font-size: 11.5px; color: var(--dim); pointer-events: none; letter-spacing: .02em; }
  .hud.tl { left: 16px; top: 14px; }
  .hud.tr { right: 16px; top: 14px; }
  .hud.bl { left: 16px; bottom: 64px; display: flex; flex-direction: column; gap: 2px; }
  .hud.br { right: 16px; bottom: 64px; color: var(--faint); }
  .hud-k { font-size: 11px; color: var(--faint); }
  .latin { font-style: italic; font-size: 15px; color: var(--ink); font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif; }
  .common { font-size: 12.5px; color: var(--signal); }
  .formula { border-top: 1px solid var(--line); padding: 12px 16px; font-size: 12px; color: var(--dim); display: flex; flex-wrap: wrap; gap: 4px 18px; justify-content: space-between; background: rgba(10, 11, 13, .55); }
  .formula sup { font-size: .78em; }
  .params { color: var(--faint); }

  .doors { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding-top: 24px; }
  .door { display: grid; grid-template-rows: auto 1fr; overflow: hidden; }
  .door-art { position: relative; height: 200px; border-bottom: 1px solid var(--line); background: radial-gradient(90% 120% at 50% 50%, #12161B 0%, #0C0E11 70%); border-radius: var(--r-card) var(--r-card) 0 0; }
  .door-art :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .door-body { padding: 22px 24px 24px; display: flex; flex-direction: column; }
  .door-path { font-size: 12px; color: var(--faint); margin: 0 0 8px; }
  .door-name { margin: 0; font-size: 28px; line-height: 1.2; font-weight: 700; letter-spacing: -.01em; display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 12px; }
  .door-alt { font-size: 14px; font-weight: 400; color: var(--dim); letter-spacing: 0; }
  .door :global(.door-sub) { margin: 8px 0 0; font-size: 17px; color: var(--ink); }
  .door-meta { margin: 6px 0 0; font-size: 14px; color: var(--dim); }
  .door-list { margin: 14px 0 0; font-size: 12px; line-height: 1.7; color: var(--faint); }
  .door .go { margin-top: 18px; }

  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .col { padding: 22px 22px 18px; display: flex; flex-direction: column; min-height: 230px; }
  .col-path { font-size: 12px; color: var(--signal); margin: 0 0 10px; }
  .col-name { font-size: 21px; margin: 0 0 8px; font-weight: 700; }
  .col :global(.col-desc) { margin: 0; color: var(--dim); font-size: 15px; line-height: 1.55; }
  .col-foot { margin-top: auto; padding-top: 18px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 14px; border-top: 1px solid var(--line); margin-left: -22px; margin-right: -22px; padding-left: 22px; padding-right: 22px; padding-top: 14px; }
  .col-latest { color: var(--ink); }

  .latest-h { flex-wrap: wrap; }
  .filters { margin-left: auto; }
  .stream { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .stream li { border-bottom: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: 104px 128px minmax(0, 1fr) 24px; gap: 16px; align-items: baseline; padding: 18px 4px; transition: background var(--t) var(--ease); border-radius: 10px; }
  .row:hover { background: rgba(230, 237, 243, .03); }
  .when { font-size: 13px; color: var(--dim); }
  .kind { justify-self: start; }
  .k-specimen { color: var(--signal); border-color: rgba(0, 255, 157, .28); }
  .k-codex { color: #7FE7FF; border-color: rgba(127, 231, 255, .25); }
  .k-artifact { color: var(--amber); border-color: rgba(255, 176, 0, .28); }
  .what { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .what :global(.row-t) { font-weight: 600; font-size: 16px; }
  .what :global(.row-s) { color: var(--dim); font-size: 14.5px; line-height: 1.5; }
  .row .arr { color: var(--faint); transition: transform var(--t) var(--ease), color var(--t) var(--ease); }
  .row:hover .arr { color: var(--signal); transform: translateX(3px); }
  .stream li[hidden] { display: none; }
  .sec :global(.empty) { display: none; color: var(--dim); font-size: 15px; padding: 20px 4px; margin: 0; }
  .sec :global(.empty.show) { display: block; }
  :global(html[data-lang="en"]) .sec :global(.empty.show[data-l="zh"]), :global(html[data-lang="zh"]) .sec :global(.empty.show[data-l="en"]) { display: none; }

  .mani { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 20px; align-items: start; }
  .rules { margin: 0; padding: 6px 0; }
  .rule { display: grid; grid-template-columns: 176px minmax(0, 1fr); gap: 16px; padding: 16px 22px; }
  .rule + .rule { border-top: 1px solid var(--line); }
  .rule dt { font-size: 13px; color: var(--signal); padding-top: 2px; }
  .rule dd { margin: 0; font-size: 16px; line-height: 1.55; }
  .quote { margin: 4px 0 18px; padding: 0 0 0 18px; border-left: 2px solid var(--signal); font-size: 19px; line-height: 1.5; font-weight: 600; text-wrap: pretty; }
  .mani-side :global(.principle) { color: var(--dim); font-size: 15px; margin: 0 0 20px; }
  .company { padding: 20px 22px; }
  .company-h { margin: 0 0 8px; font-weight: 700; font-size: 17px; }
  .company :global(.company-p) { margin: 0; font-size: 15px; }
  .company :global(.company-motto) { margin: 6px 0 0; font-size: 15px; color: var(--signal); }
  .company :global(.company-addr) { margin: 12px 0 0; font-size: 13px; line-height: 1.6; color: var(--dim); font-family: var(--font-mono); }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; gap: 28px; padding-top: 40px; }
    .cols { grid-template-columns: 1fr; }
    .col { min-height: 0; }
    .mani { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .doors { grid-template-columns: 1fr; gap: 16px; }
    .door-art { height: 168px; }
    .row { grid-template-columns: 1fr auto; gap: 6px 12px; padding: 16px 2px; }
    .row .when { order: 1; }
    .row .kind { order: 2; justify-self: end; }
    .row .what { order: 3; grid-column: 1 / -1; }
    .row .arr { display: none; }
    .filters { margin-left: 0; width: 100%; overflow-x: auto; }
    .rule { grid-template-columns: 1fr; gap: 4px; padding: 14px 18px; }
    .hud.bl, .hud.br { bottom: 76px; }
  }
  @media (max-width: 640px) {
    .wide-only { display: none; }
    .hero { padding-top: 28px; }
    .h1 { font-size: 38px; }
    .hero :global(.lede) { font-size: 17px; }
    .viewport { aspect-ratio: 1 / 1.02; }
    .formula { font-size: 11px; }
    .door-name { font-size: 24px; }
  }

  /* 无头态：取景框只剩一个写明「已销毁」的框 */
  :global(html[data-mode="headless"]) .viewport { aspect-ratio: auto; min-height: 0; background: #000 !important; }
  :global(html[data-mode="headless"]) .hud.tl, :global(html[data-mode="headless"]) .hud.tr { position: static; padding: 12px 16px 0; }
  :global(html[data-mode="headless"]) .hud.bl { position: static; padding: 8px 16px 12px; }
  :global(html[data-mode="headless"]) .door-art { display: none; }
</style>
