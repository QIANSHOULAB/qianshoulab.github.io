---
// 首页：造物之门。发到 /zero/（根目录换不换看 _zero/home.mjs 那一行）。
// 黑水尽头一道门，门里是光。往下滑，门里一样一样往外生东西：光、日、环、生灵、器、律。滑的人就是造物主。
// 骨架：一个约 10.5 屏高的滚动容器，画布固定铺满；七个 section 在页面里各有标题、那句话、链接（读屏软件读到的是七段正常的字）。
// 不用 scroll-snap，不劫持滚轮。three.js 异步加载，黑底和 wordmark 先出来。
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/core/Footer.astro';
import T from '../components/core/T.astro';
import Ink from '../components/core/Ink.astro';
import { t, ENTRIES } from '../i18n/ui';
import { shop } from '../data/tools';
import { SCROLL, SECTION_HEX } from '../genesis/config';
import stills from '../genesis/stills';

const NUM = ['Ⅰ', 'Ⅱ', 'Ⅲ', 'Ⅳ', 'Ⅴ', 'Ⅵ', 'Ⅶ'];
const ACTS = [2, 3, 4, 5, 6].map((k) => ({ k, e: ENTRIES[k - 2] }));
// 每个 section 多高（屏）：首屏 1 + lead，Ⅱ–Ⅵ 各 1.5，Ⅶ 1.8
const H = [1 + SCROLL.lead, ...SCROLL.acts];
const mail = ['oilsongchengmin', 'gmail.com'].join('@');
---
<BaseLayout home>
  <div class="gx" data-gx style={`--n:${H.length}`}>
    <div class="stage" data-stage>
      <div class="gl-host" data-gl-host></div>
      <img class="still" alt="" aria-hidden="true" decoding="async" data-stills={JSON.stringify(stills)} />
      <noscript><img class="still on" src={stills.land[0]} alt="" /></noscript>
      <p class="intro-code mono" aria-hidden="true" data-intro>
        <span class="ic ic1"><Ink text={t('en', 'act.a1.c1')} mode="type" l="en" /><Ink text={t('zh', 'act.a1.c1')} mode="type" l="zh" /></span>
        <span class="ic ic2"><Ink text={t('en', 'act.a1.c2')} mode="type" /></span>
      </p>
      <div class="tags" aria-hidden="true" data-tags>
        <div class="spec" data-spec>
          <span class="spec-no"><T k="label.no" /></span>
          <span class="spec-kind"><T k="label.kind" /></span>
          <span class="spec-sp"><T k="label.spec" /></span>
        </div>
      </div>
      <nav class="ticks" aria-label={t('en', 'home.acts')} data-aria-en={t('en', 'home.acts')} data-aria-zh={t('zh', 'home.acts')} data-ticks>
        {NUM.map((n, i) => (
          <button type="button" class="tk" data-k={i + 1} aria-label={`${n} ${t('en', `act.a${i + 1}.name`)}`} data-aria-en={`${n} ${t('en', `act.a${i + 1}.name`)}`} data-aria-zh={`${n} ${t('zh', `act.a${i + 1}.name`)}`}>
            <span class="tk-n" aria-hidden="true">{n}</span><span class="tk-l" aria-hidden="true"></span>
          </button>
        ))}
      </nav>
      <div class="bar" aria-hidden="true" data-bar><span></span></div>
    </div>

    <!-- Ⅰ 启光：首屏。wordmark、一句话、五条铭文（点了直接进栏目）、往下滑的提示 -->
    <section class="act a1" data-act="1" style={`--h:${H[0]}`} aria-labelledby="a1-h">
      <div class="hero" data-hero>
        <div class="title">
          <h1 class="wm" id="a1-h">
            <span class="wm-a" data-l="en" lang="en">ZERO-FLESH CREATION</span><span class="wm-b" data-l="en" lang="zh-CN">零肉身造物</span>
            <span class="wm-a" data-l="zh" lang="zh-CN">零肉身造物</span><span class="wm-b" data-l="zh" lang="en">ZERO-FLESH CREATION</span>
          </h1>
          <T as="p" class="tag" k="home.tagline" />
          <p class="hint hint-m mono" aria-hidden="true"><T k="home.hint" /><span class="hint-l"></span></p>
        </div>
        <nav class="entries" aria-label={t('en', 'home.entries')} data-aria-en={t('en', 'home.entries')} data-aria-zh={t('zh', 'home.entries')}>
          <ol>
            {ENTRIES.map((e, i) => (
              <li>
                <a class="entry" href={e.href} data-k={i} style={`--c:${SECTION_HEX[i]}`}>
                  <span class="tick" aria-hidden="true"></span>
                  <span class="no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="nm" data-l="en" lang="en">{t('en', `entry.${e.key}.name`)}</span>
                  <span class="nm" data-l="zh" lang="zh-CN">{t('zh', `entry.${e.key}.name`)}</span>
                  <span class="sr"><span data-l="en"> — {t('en', `entry.${e.key}.line`)}</span><span data-l="zh">：{t('zh', `entry.${e.key}.line`)}</span></span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
        <p class="hint hint-d mono" aria-hidden="true"><T k="home.hint" /><span class="hint-l"></span></p>
      </div>
    </section>

    {ACTS.map(({ k, e }, i) => (
      <section class={`act a${k}`} data-act={k} style={`--h:${H[k - 1]}`} aria-labelledby={`a${k}-h`}>
        <div class="act-in" data-act-in={k}>
          <p class="code mono" aria-hidden="true"><Ink text={t('en', `act.a${k}.code`)} mode="type" /><span class="caret"></span></p>
          <h2 class="act-h" id={`a${k}-h`}>
            <span class="act-tag mono"><span class="act-no">{NUM[k - 1]}</span> <Ink text={t('en', `act.a${k}.name`)} l="en" lang="en" /><Ink text={t('zh', `act.a${k}.name`)} l="zh" lang="zh-CN" /></span>
            <span class="sec"><span class="sec-no mono">{String(i + 1).padStart(2, '0')}</span> <Ink text={t('en', `entry.${e.key}.name`)} l="en" lang="en" /><Ink text={t('zh', `entry.${e.key}.name`)} l="zh" lang="zh-CN" /></span>
          </h2>
          <p class="act-row">
            <span class="act-line"><Ink text={t('en', `entry.${e.key}.line`)} l="en" lang="en" /><Ink text={t('zh', `entry.${e.key}.line`)} l="zh" lang="zh-CN" /></span>
            <a class="act-go mono" href={e.href} data-go={k}><T k="home.enter" /><span class="arr" aria-hidden="true">→</span></a>
          </p>
        </div>
        {k === 3 && (
          <ul class="moons" data-moons>
            {shop.map((x, j) => (
              <li><a class="moon" href={x.href} data-moon={j}><span class="moon-nm"><T en={x.name.en} zh={x.name.zh} /></span> <span class="moon-pr mono"><T k="moon.price" /></span></a></li>
            ))}
          </ul>
        )}
      </section>
    ))}

    <!-- Ⅶ 收工：return; 然后只剩那句话；下面是公司那一行、宇宙地址、五个栏目、飞鸽传书 -->
    <section class="act a7" data-act="7" style={`--h:${H[6]}`} aria-labelledby="a7-h">
      <div class="fin" data-fin>
        <p class="code mono" aria-hidden="true"><Ink text={t('en', 'act.a7.code')} mode="type" /><span class="caret"></span></p>
        <h2 class="sr" id="a7-h"><span data-l="en">Ⅶ {t('en', 'act.a7.name')}</span><span data-l="zh">Ⅶ {t('zh', 'act.a7.name')}</span></h2>
        <p class="motto"><Ink text={t('en', 'finale.motto')} l="en" lang="en" /><Ink text={t('zh', 'finale.motto')} l="zh" lang="zh-CN" /></p>
        <div class="fin-more">
          <Footer compact />
          <nav class="fin-nav" aria-label={t('en', 'nav.label')} data-aria-en={t('en', 'nav.label')} data-aria-zh={t('zh', 'nav.label')}>
            <ol>
              {ENTRIES.map((e, i) => (
                <li><a href={e.href} style={`--c:${SECTION_HEX[i]}`}><span class="no mono">{String(i + 1).padStart(2, '0')}</span> <T en={t('en', `entry.${e.key}.name`)} zh={t('zh', `entry.${e.key}.name`)} /></a></li>
              ))}
            </ol>
          </nav>
          <p class="fin-mail mono"><a href={`mailto:${mail}?subject=${encodeURIComponent('零肉身造物 · Zero-Flesh Creation')}`} title={mail}><T k="foot.mail" /></a></p>
        </div>
      </div>
    </section>
  </div>
  <div class="flood" aria-hidden="true" data-flood></div>
</BaseLayout>

<script>
  import '../home/genesis-page';
</script>

<style>
  /* —— 骨架：滚动容器高约 10.5 屏，画布固定铺满。--vh 是稳定的一屏高（手机地址栏收放不跟着变），JS 定，没 JS 时就是 100vh —— */
  :global(html) { --vh: 1vh; background: #000; overscroll-behavior-y: none; }
  :global(body.is-home) { background: #000; }
  .gx { position: relative; }
  .act { position: relative; height: calc(var(--vh) * 100 * var(--h)); }
  .stage { position: fixed; left: 0; top: 0; width: 100%; height: 100vh; height: 100lvh; overflow: hidden; background: #000; z-index: 0; will-change: transform; }
  .gl-host { position: absolute; inset: 0; }
  .gl-host :global(canvas.gl) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: none; opacity: 1; }
  :global(html[data-gl="no"]) .still, .still:global(.on) { display: block; }
  /* 一层极淡的胶片颗粒，压在画面上，字下面 */
  .gl-host::after { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: var(--grain); background-size: 160px 160px; opacity: .04; mix-blend-mode: screen; }

  :global(.is-home) :global(.hd) { position: fixed; top: 0; left: 0; right: 0; z-index: 30; }

  /* —— 字的位置跟地平线走（--hz：地平线离底边多高，JS 每帧跟画面同一把尺子定）—— */
  .gx { --hz: .4; --safe: 0px; }

  /* —— Ⅰ 首屏 —— */
  .hero { position: fixed; inset: 0; z-index: 5; pointer-events: none; opacity: var(--hero, 1); visibility: var(--hero-v, visible); }
  .title { position: absolute; left: 0; right: 0; top: 0; height: calc(var(--title-h, 30) * 1%); padding: 44px 16px 0; box-sizing: border-box;
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  .wm { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 12px; font-weight: 500; }
  .wm-a { font: 500 clamp(21px, 2.1vw, 30px)/1 var(--serif); letter-spacing: .46em; padding-left: .46em; color: #f2f2f2; white-space: nowrap; }
  .wm-b { font: 500 12px/1 var(--serif-zh); letter-spacing: 1.1em; padding-left: 1.1em; color: #b9b9b9; }
  :global(html[data-lang="zh"]) .wm-a { font: 500 clamp(24px, 2.4vw, 32px)/1 var(--serif-zh); letter-spacing: .72em; padding-left: .72em; }
  :global(html[data-lang="zh"]) .wm-b { font: 500 11px/1 var(--serif); letter-spacing: .5em; padding-left: .5em; }
  .title :global(.tag) { margin: 18px 0 0; font: 400 11.5px/1.4 var(--mono); letter-spacing: .14em; color: #d2d2d2; text-shadow: 0 0 18px rgba(0, 0, 0, .6); }
  :global(html[data-lang="zh"]) .title :global(.tag) { font: 500 13px/1.4 var(--serif-zh); letter-spacing: .36em; padding-left: .36em; }

  .entries { position: absolute; left: 0; right: 0; top: calc((1 - var(--hz)) * 100% + var(--egap)); --egap: clamp(48px, 11vh, 124px); }
  .entries ol { list-style: none; margin: 0 auto; padding: 0 16px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); justify-items: center; align-items: start; max-width: min(1080px, 100%); box-sizing: border-box; }
  .entries li { display: flex; justify-content: center; min-width: 0; }
  .entry { position: relative; display: flex; flex-direction: column; align-items: center; gap: 9px; padding: 0 2px 6px; color: #b4b4b4; pointer-events: auto;
    text-shadow: 0 0 14px rgba(0, 0, 0, .85), 0 0 3px rgba(0, 0, 0, .7); transition: color .35s var(--ease); }
  .entry::before { content: ""; position: absolute; left: -22px; right: -22px; top: 14px; bottom: -14px; z-index: -1; pointer-events: none; background: radial-gradient(closest-side, rgba(0, 0, 0, .5), rgba(0, 0, 0, 0)); }
  .entries li:nth-child(3) .entry::before { left: -30px; right: -30px; top: 0; background: radial-gradient(closest-side, rgba(0, 0, 0, .72), rgba(0, 0, 0, 0)); }
  .tick { width: 1px; height: 18px; background: currentColor; opacity: .55; transform-origin: 50% 100%; transition: opacity .35s var(--ease), transform .5s var(--ease), background .35s var(--ease); }
  .no { font: 400 10.5px/1 var(--mono); letter-spacing: .16em; padding-left: .16em; color: #9a9a9a; transition: color .35s var(--ease); }
  .nm { font: 500 15px/1.2 var(--serif); letter-spacing: .28em; padding-left: .28em; white-space: nowrap; }
  :global(html[data-lang="zh"]) .nm { font: 500 15px/1.2 var(--serif-zh); letter-spacing: .4em; padding-left: .4em; }
  .entry:hover, .entry:focus-visible, .entry:global(.on) { color: #fff; }
  .entry:hover .tick, .entry:focus-visible .tick, .entry:global(.on) .tick { opacity: 1; transform: scaleY(1.5); background: var(--c); }
  .entry:focus-visible { outline: none; }
  .entry:focus-visible .nm { outline: 1px solid #fff; outline-offset: 6px; }
  .hint { position: absolute; left: 0; right: 0; bottom: calc(var(--safe) + 22px); margin: 0; display: flex; flex-direction: column; align-items: center; gap: 10px;
    font-size: 10.5px; letter-spacing: .26em; color: #8a8a8a; text-transform: uppercase; }
  :global(html[data-lang="zh"]) .hint { font: 500 12px/1 var(--serif-zh); letter-spacing: .4em; text-transform: none; }
  .hint-m { display: none; }
  .hint-l { width: 1px; height: 28px; background: linear-gradient(#8a8a8a, rgba(138, 138, 138, 0)); animation: drip 2.6s var(--slow) infinite; transform-origin: top; }
  @keyframes drip { 0% { transform: scaleY(0); opacity: 1; } 60% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(1); opacity: 0; } }

  /* —— 开场两行代码：正中，打字 —— */
  .intro-code { position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-50%); margin: 0; z-index: 4; display: flex; flex-direction: column; align-items: center; gap: 10px;
    font-size: 12.5px; letter-spacing: .06em; color: #cfcfcf; pointer-events: none; opacity: var(--intro-o, 0); }
  :global(html[data-lang="zh"]) .ic1 { font-family: var(--mono); }
  .ic1 { --w: var(--c1, 0); color: #8f8f8f; }
  .ic2 { --w: var(--c2, 0); }

  /* —— Ⅱ–Ⅵ 每幕的字：先打出一行代码，造完了名字才一个字一个字写出来 —— */
  .act-in { position: fixed; left: 0; right: 0; margin: 0 auto; bottom: calc(var(--safe) + var(--abot, 5vh)); width: min(760px, calc(100% - 32px)); z-index: 6;
    text-align: center; opacity: var(--o, 0); visibility: var(--v, hidden); pointer-events: none; --w: 0; --cw: 0; }
  /* 字底下一团暗：水上的字不被光路冲掉 */
  .act-h::before { content: ""; position: absolute; left: 50%; bottom: -10px; width: min(640px, 100%); height: 190px; transform: translateX(-50%); z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgba(0, 0, 0, .62), rgba(0, 0, 0, 0)); opacity: clamp(0, var(--w) * 3, 1); }
  .act-no, .sec-no { opacity: clamp(0, var(--w) * 6, 1); }
  /* 那行代码打在天上（法先到，东西还没出来）；名字在水上 */
  .act-in .code { position: fixed; left: 16px; right: 16px; top: calc(var(--code-top, 12) * 1vh); margin: 0; font-size: 12.5px; letter-spacing: .05em; color: #b4b4b4; --w: var(--cw); text-shadow: 0 0 10px rgba(0, 0, 0, .9); }
  .caret { display: inline-block; width: .55em; height: 1.05em; margin-left: 2px; vertical-align: -.16em; background: #bdbdbd; opacity: var(--caret, 0); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { visibility: hidden; } }
  .act-h { position: relative; margin: 0; font-weight: 500; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .act-tag { font-size: 10.5px; letter-spacing: .34em; padding-left: .34em; color: #9d9d9d; text-transform: uppercase; }
  :global(html[data-lang="zh"]) .act-tag { font: 500 12px/1 var(--serif-zh); letter-spacing: .5em; padding-left: .5em; }
  .act-no { font-family: var(--serif); font-size: 13px; letter-spacing: 0; color: #d8d8d8; margin-right: .5em; }
  .sec { font: 500 clamp(22px, 2.3vw, 31px)/1.1 var(--serif); letter-spacing: .3em; padding-left: .3em; color: #f2f2f2; white-space: nowrap; text-shadow: 0 0 22px rgba(0, 0, 0, .8); }
  :global(html[data-lang="zh"]) .sec { font-family: var(--serif-zh); letter-spacing: .42em; padding-left: .42em; font-size: clamp(22px, 2.2vw, 29px); }
  .sec-no { font-size: 11px; letter-spacing: .16em; color: #8e8e8e; vertical-align: .55em; margin-right: .6em; }
  .act-row { margin: 12px 0 0; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .act-line { font: 400 12px/1.5 var(--mono); letter-spacing: .06em; color: #cdcdcd; text-shadow: 0 0 12px rgba(0, 0, 0, .9); }
  :global(html[data-lang="zh"]) .act-line { font: 500 14px/1.5 var(--serif-zh); letter-spacing: .3em; padding-left: .3em; }
  .act-go { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 44px; min-width: 112px; padding: 0 18px; box-sizing: border-box;
    font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #ececec; border: 1px solid rgba(255, 255, 255, .26); background: rgba(0, 0, 0, .28);
    opacity: var(--go, 0); pointer-events: var(--go-pe, none); transition: border-color .25s var(--ease), background .25s var(--ease); }
  :global(html[data-lang="zh"]) .act-go { font: 500 13px/1 var(--serif-zh); letter-spacing: .4em; padding-left: calc(18px + .4em); }
  .act-go:hover, .act-go:focus-visible { border-color: rgba(255, 255, 255, .7); background: rgba(255, 255, 255, .06); }
  .act-go .arr { transition: transform .25s var(--ease); }
  .act-go:hover .arr { transform: translateX(3px); }


  /* —— Ⅲ 小月的名字：跟着转到正面的那颗月亮走，能点 —— */
  .moons { list-style: none; margin: 0; padding: 0; }
  .moon { position: fixed; left: 0; top: 0; z-index: 7; display: inline-flex; align-items: center; gap: 10px; min-height: 36px; padding: 0 10px; white-space: nowrap;
    font: 500 14px/1 var(--serif); letter-spacing: .12em; color: #f0f0f0; text-shadow: 0 0 12px rgba(0, 0, 0, .9);
    transform: translate(var(--mx, -999px), var(--my, -999px)); opacity: var(--mo, 0); pointer-events: var(--mpe, none); }
  :global(html[data-lang="zh"]) .moon { font-family: var(--serif-zh); letter-spacing: .2em; }
  .moon::before { content: ""; width: 22px; height: 1px; background: rgba(255, 255, 255, .55); }
  .moon-pr { font-size: 10.5px; letter-spacing: .1em; color: #a0a0a0; }
  .moon:hover .moon-nm, .moon:focus-visible .moon-nm { border-bottom: 1px solid #fff; }

  /* —— Ⅳ 标本签 —— */
  .tags { position: absolute; inset: 0; pointer-events: none; z-index: 4; }
  .spec { position: absolute; left: 0; top: 0; display: flex; flex-direction: column; gap: 5px; padding-left: 12px; border-left: 1px solid rgba(255, 255, 255, .4);
    transform: translate(var(--sx, -999px), var(--sy, -999px)); opacity: var(--so, 0); font: 400 10px/1.25 var(--mono); letter-spacing: .12em; color: #bfe9f2; }
  .spec-no { color: #fff; font-size: 11px; }
  :global(html[data-lang="zh"]) .spec { letter-spacing: .08em; }

  /* —— 右边一列七个小刻度（手机竖屏收成底部一条细线）—— */
  .ticks { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); z-index: 20; display: flex; flex-direction: column; opacity: var(--ticks, 0); transition: opacity .5s var(--ease); }
  .tk { appearance: none; background: none; border: 0; padding: 0 8px; height: 30px; min-width: 44px; display: flex; align-items: center; justify-content: flex-end; gap: 8px; cursor: pointer; color: #6e6e6e; }
  .tk-n { font: 500 11px/1 var(--serif); letter-spacing: 0; opacity: 0; transition: opacity .3s var(--ease), color .3s var(--ease); }
  .tk-l { width: 10px; height: 1px; background: currentColor; transition: width .3s var(--ease), background .3s var(--ease); }
  .tk:hover .tk-n, .tk:focus-visible .tk-n, .tk:global(.on) .tk-n { opacity: 1; }
  .tk:hover, .tk:focus-visible { color: #d0d0d0; }
  .tk:global(.on) { color: #fff; }
  .tk:global(.on) .tk-l { width: 22px; }
  .bar { display: none; }

  /* —— Ⅶ 收工 —— */
  .fin { position: fixed; left: 0; right: 0; margin: 0 auto; bottom: calc(var(--safe) + 4.5vh); width: min(920px, calc(100% - 32px)); z-index: 6; text-align: center;
    opacity: var(--fo, 0); visibility: var(--fv, hidden); pointer-events: var(--fpe, none); }
  /* 字底下一团暗：门洞那道白光收暗以后，字落在暗处 */
  .fin::before { content: ""; position: absolute; left: 50%; top: -70px; bottom: -50px; width: min(1100px, 140%); transform: translateX(-50%); z-index: -1; pointer-events: none;
