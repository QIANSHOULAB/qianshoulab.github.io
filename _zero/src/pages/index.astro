  :global(html[data-gl="yes"][data-dust="yes"]) .sky .nm::before { display: none; }
  /* 落定以后照造出来的先后一个个亮；往回滑一下子收掉（造物飞回去之前，名字先走）。没亮的时候只是透明、点不着——键盘 Tab 照样走得到、读屏照样念得到 */
  :global(html[data-names]) .sky .nm:global(.ok) { opacity: 1; pointer-events: auto;
    transition: opacity .7s var(--ease) calc(var(--i) * var(--stagger)), color .3s var(--ease), text-shadow .3s var(--ease); }
  :global(html[data-names-now]) .sky .nm:global(.ok) { transition-delay: 0s; }
  /* 法典换落点（轨道的缺口快转到它那儿了）：先淡出，换个刚画上的点再亮 */
