---
// 首页：造物之门。新家 https://zeroflesh.github.io/ 的根目录 /（11-28 从 qianshoulab.github.io/zero/ 搬来）。
// 画布固定铺满，往下滑是在创世：七幕，全程跟手，倒着滑会倒放。画面跟着滚动走，字跟着画面走。
// v3.1（Song 11-28）：画面上只留名字。首屏一个 wordmark 和一个很小的往下滑提示；第二到第六幕只有栏目名和「进去」。
// v3.2（Song 11-28 选的 C 星空目录）：名字只挂在造出来的东西上。第七幕「开天」那片天里，五个名字挂在五样造物旁边（太阳千手院、星环赛博杂货铺、
// 巨鲸标本、浑天仪文物、轨道法典），点名字或者点造物本身就冲进去；顶栏正中「目录」一键快进到这片天。原来结尾底下那一排五个名字，
// 只在没有 WebGL、没开 JS 的时候留着当兜底。底色是墨蓝（--night，tune.ts 的 INK），整页没有一块纯黑。
// v3.3（Song 11-28）：停手以后自己走到每一幕的展示位置（../home/glide.ts）；字换成「星尘字」——wordmark、五个栏目名、那句话、天上五个名字
// 画在 3D 里（造物身上掉下来的碎块、飞上天的星聚成），页面里这份真字照旧在（读屏、Tab、搜索、翻译开关靠它），只是看不见，每帧摆到 3D 那份的位置上。
// 小字不聚：「进去」、往下滑、顶栏、页脚（片尾字幕）是新字体的普通字。全首页没有宋体。
// three.js 异步加载，墨蓝底先出来，3D 后到。
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/core/T.astro';
import { t, ENTRIES } from '../i18n/ui';
import { shop } from '../data/tools';
import { SCROLL, SECTION_HEX, NAMES } from '../scene/tune';
// 七幕各一张静态图（scripts/stills.mjs 截的）：没有 WebGL 时首页用它们
const stillMods = import.meta.glob('../assets/stills/*.jpg', { eager: true, query: '?url', import: 'default' }) as Record<string, string>;
const still = (k: number, o: 'l' | 'p') => stillMods[`../assets/stills/act${k}-${o}.jpg`];

const ACTS = ENTRIES.map((e, i) => ({ ...e, k: i + 2, hex: SECTION_HEX[i] }));
// 天上的名字照造出来的先后一个个亮：日 → 环 → 鲸 → 器 → 轨道（= 千手院 → 法典），每个隔这么久
const stagger = NAMES.stagger;
const units = SCROLL.hold + SCROLL.acts.reduce((a, b) => a + b, 0) + SCROLL.tail + 1;
const chars = (s: string) => [...s].map((c, i) => ({ c, i }));
const mail = ['oilsongchengmin', 'gmail.com'].join('@');
const SEVEN = [1, 2, 3, 4, 5, 6, 7];
const stills = { l: SEVEN.map((k) => still(k, 'l')), p: SEVEN.map((k) => still(k, 'p')) };
const nm = (l: 'en' | 'zh', key: string) => t(l, `entry.${key}.name`);
// 那句话拆成两半（各自不断行）：屏宽放得下就一行，放不下就从句号 / 逗号那儿换行，不会断在「把肉身」后面
const motto = { en: t('en', 'company.motto').replace(/^—\s*/, ''), zh: t('zh', 'company.motto').replace(/^——/, '') };
const halves = (s: string) => { const m = /^(.+?[.，])\s*(.+)$/.exec(s); return m ? [m[1], m[2]] : [s]; };
// 地址拆成几段（片尾字幕一段一行，段与段之间的「 · 」照旧留着）
const addrParts = (l: 'en' | 'zh') => t(l, 'company.addr').split(' · ');
// 右边七个刻度没有字；读屏念的是它通到哪：首屏念 wordmark，第二到第六幕念栏目名，第七幕念「五个入口」
const tickName = (l: 'en' | 'zh', k: number) => (k === 1 ? (l === 'en' ? 'Zero-Flesh Creation' : '零肉身造物') : k === 7 ? t(l, 'acts.doors') : nm(l, ENTRIES[k - 2].key));
---
<BaseLayout home>
  <div class="stage" data-stage data-moons={shop.length} aria-hidden="true">
    <div class="gl-host" data-gl-host></div>
    <img class="still" alt="" data-stills={JSON.stringify(stills)} decoding="async" />
    <noscript><picture><source media="(max-aspect-ratio: 4/5)" srcset={still(7, 'p')} /><img class="still on" src={still(7, 'l')} alt="" /></picture></noscript>
  </div>

  <div class="ui" data-ui>
    <section class="hero" data-hero aria-labelledby="h-hero">
      <div class="title">
        <h1 class="wm" id="h-hero">
          <span class="wm-a" data-l="en" lang="en">ZERO-FLESH CREATION</span><span class="wm-b" data-l="en" lang="zh-CN">零肉身造物</span>
          <span class="wm-a" data-l="zh" lang="zh-CN">零肉身造物</span><span class="wm-b" data-l="zh" lang="en">ZERO-FLESH CREATION</span>
        </h1>
      </div>
      <p class="hint" aria-hidden="true"><T k="acts.hint" /><span class="hint-line"></span></p>
    </section>

    {ACTS.map((a) => (
      <section class="act" data-act={a.k} style={`--c:${a.hex}`} aria-labelledby={`h-act${a.k}`}>
        <div class="card">
          <h2 class="act-name" id={`h-act${a.k}`}>
            <span data-l="en" lang="en"><span class="sr">{nm('en', a.key)}</span><span class="chs" aria-hidden="true">{chars(nm('en', a.key)).map(({ c, i }) => <span class="ch" style={`--i:${i}`}>{c}</span>)}</span></span>
            <span data-l="zh" lang="zh-CN"><span class="sr">{nm('zh', a.key)}</span><span class="chs" aria-hidden="true">{chars(nm('zh', a.key)).map(({ c, i }) => <span class="ch" style={`--i:${i}`}>{c}</span>)}</span></span>
          </h2>
          <a class="go" href={a.href} data-go={a.k} id={`go${a.k}`} aria-labelledby={`go${a.k} h-act${a.k}`}><T k="acts.enter" /><span class="arr" aria-hidden="true">→</span></a>
        </div>
      </section>
    ))}

    <section class="act act7" data-act="7" aria-labelledby="h-act7">
      <div class="end" data-end>
        <h2 class="motto" id="h-act7">
          <span data-l="en" lang="en">{halves(motto.en).map((h, i) => <>{i > 0 && ' '}<span class="mh">{h}</span></>)}</span>
          <span data-l="zh" lang="zh-CN">{halves(motto.zh).map((h) => <span class="mh">{h}</span>)}</span>
        </h2>
        {/* 兜底：没有 WebGL、没开 JS 的时候才露出来的一排五个名字（有 3D 的时候，五个名字挂在天上，这一排不占眼也不进读屏） */}
        <nav class="links" aria-label={t('en', 'acts.doors')} data-aria-en={t('en', 'acts.doors')} data-aria-zh={t('zh', 'acts.doors')}>
          {ENTRIES.map((e, i) => (
            <a href={e.href} data-end-go={i} style={`--c:${SECTION_HEX[i]}`}><T k={`entry.${e.key}.name`} /></a>
          ))}
        </nav>
      </div>
      {/* 天上的五个名字（目录）：每帧由 home.ts 摆到各自那样造物旁边；法典多一根很短的细线，那头连在轨道上 */}
      <nav class="sky" id="sky-index" aria-label={t('en', 'acts.index')} data-aria-en={t('en', 'acts.index')} data-aria-zh={t('zh', 'acts.index')} data-sky style={`--stagger:${stagger}ms`}>
        <span class="lead" aria-hidden="true" data-lead></span>
        {ENTRIES.map((e, i) => (
          <a class="nm" href={e.href} data-sky-go={i} style={`--i:${i}`}><T k={`entry.${e.key}.name`} /></a>
        ))}
      </nav>
      {/* 页脚：片尾字幕（细、小、居中、行距松、灰一点，一行行淡进来；字一个不改） */}
      <div class="foot" data-foot>
        <p class="co cr" style="--r:0"><span class="co-nm" lang="zh-CN">零肉身造物 | Zero-Flesh Creation</span> <T k="company.p1" /></p>
        <p class="addr cr" style="--r:1">
          <span data-l="en" lang="en">{addrParts('en').map((x, i, a) => <span class="al">{x}{i < a.length - 1 ? ' · ' : ''}</span>)}</span>
          <span data-l="zh" lang="zh-CN">{addrParts('zh').map((x, i, a) => <span class="al">{x}{i < a.length - 1 ? ' · ' : ''}</span>)}</span>
        </p>
        <p class="mail cr" style="--r:2"><a href={`mailto:${mail}?subject=${encodeURIComponent('零肉身造物 · Zero-Flesh Creation')}`} title={mail}><T k="foot.mail" /></a></p>
      </div>
    </section>
  </div>

  <nav class="ticks" aria-label={t('en', 'acts.label')} data-aria-en={t('en', 'acts.label')} data-aria-zh={t('zh', 'acts.label')} data-ticks>
    {SEVEN.map((k) => (
      <button type="button" data-tick={k} aria-label={tickName('en', k)} data-aria-en={tickName('en', k)} data-aria-zh={tickName('zh', k)}>
        <span class="tk-m" aria-hidden="true"></span>
      </button>
    ))}
  </nav>

  <div class="track" aria-hidden="true" style={`--units:${units}`}></div>
  <div class="flood" aria-hidden="true" data-flood></div>
</BaseLayout>

<script>
  import '../home/home';
</script>

<style>
  /* 画布和字都固定铺满一屏（用最大视口高：iPhone 地址栏收放时不跳）；往下滑的长度由 .track 撑出来 */
  .stage, .ui { position: fixed; left: 0; top: 0; width: 100%; height: 100vh; height: 100lvh; --hzf: .40; --monof: .38; }
  @media (max-aspect-ratio: 1/1) { .stage, .ui { --hzf: .37; --monof: .34; } }
  @media (max-aspect-ratio: 3/4) { .stage, .ui { --hzf: .355; --monof: .31; } }
  .stage { z-index: 0; background: var(--bg); overflow: hidden; }
  .gl-host { position: absolute; inset: 0; }
  .gl-host :global(canvas.gl) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: none; transition: opacity .6s var(--ease); }
  :global(html[data-gl="no"]) .still, .still:global(.on) { display: block; }
  .gl-host::after { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: var(--grain); background-size: 160px 160px; opacity: var(--grain-o); mix-blend-mode: screen; }
  .ui { z-index: 5; pointer-events: none; }
  .track { position: relative; height: calc(var(--units) * 100vh); height: calc(var(--units) * 100lvh); }
  :global(.is-home) :global(.hd) { position: fixed; top: 0; left: 0; right: 0; z-index: 30; transition: opacity .5s var(--ease); }
  :global(html[data-scrolled]) :global(.is-home) :global(.hd) { opacity: .72; }
  :global(html[data-sky]) :global(.is-home) :global(.hd) { opacity: .95; }

  /* —— v3.3 星尘字：有 3D 的时候，大字（wordmark、栏目名、那句话、天上五个名字）画在画面里；页面里这份看不见（读屏、Tab、搜索还在），
     位置跟着 3D 那份摆（home.ts）。3D 没搭起来（data-dust="no"）就照常显示。 —— */
  :global(html[data-gl="yes"]:not([data-dust="no"])) .wm,
  :global(html[data-gl="yes"]:not([data-dust="no"])) .act-name,
  :global(html[data-gl="yes"]:not([data-dust="no"])) .motto,
  :global(html[data-gl="yes"]:not([data-dust="no"])) .sky .nm { color: transparent !important; text-shadow: none !important; }
  :global(html[data-gl="yes"]:not([data-dust="no"])) .wm *, :global(html[data-gl="yes"]:not([data-dust="no"])) .act-name *, :global(html[data-gl="yes"]:not([data-dust="no"])) .motto * { color: transparent !important; }

  /* —— 一个字一个字写出来（没有 3D 的时候）：.on 的时候按 --i 依次亮；退的时候一起退 —— */
  .chs :global(.ch) { opacity: 0; transition: opacity .18s var(--ease); }
  .act:global(.on) .card .chs :global(.ch) { opacity: 1; transition: opacity .45s var(--ease) calc(var(--i) * 34ms); }
  .chs { white-space: pre; }

  /* —— 首屏：wordmark（门顶上那块天；有 3D 时画在画面里，跟门一样早在暗里，光升起来才照出来）和最底下一个很小的往下滑提示 —— */
  .hero { position: absolute; inset: 0; transition: opacity .7s var(--ease); }
  .hero:not(:global(.on)) .hint { opacity: 0; }
  :global(html[data-gl="no"]) .hero:not(:global(.on)), :global(html[data-dust="no"]) .hero:not(:global(.on)) { opacity: 0; }
  .hint { transition: opacity .7s var(--ease); }
  .title { position: absolute; left: 0; right: 0; top: 0; height: calc((1 - var(--hzf) - var(--monof)) * 100%); padding: 44px 16px 0; box-sizing: border-box;
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  .wm { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 12px; font-weight: 300; }
  .wm-a { font: 300 clamp(21px, 2.1vw, 30px)/1 var(--display); letter-spacing: .46em; padding-left: .46em; color: #f2f2f2; white-space: nowrap; }
  .wm-b { font: 300 12px/1 var(--display-zh); letter-spacing: 1.1em; padding-left: 1.1em; color: #b9b9b9; }
  :global(html[data-lang="zh"]) .wm-a { font: 300 clamp(24px, 2.4vw, 32px)/1 var(--display-zh); letter-spacing: .72em; padding-left: .72em; }
  :global(html[data-lang="zh"]) .wm-b { font: 300 11px/1 var(--display); letter-spacing: .5em; padding-left: .5em; }
  .hint { position: absolute; left: 0; right: 0; bottom: 26px; margin: 0; display: flex; flex-direction: column; align-items: center; gap: 9px;
    font: 300 9.5px/1 var(--display); letter-spacing: .34em; padding-left: .34em; text-transform: uppercase; color: #a8adb7; text-shadow: 0 0 6px var(--bg), 0 0 2px var(--bg); }
  :global(html[data-lang="zh"]) .hint { font: 300 10px/1 var(--display-zh); letter-spacing: .5em; padding-left: .5em; }
  /* 提示正压在门的那条光路上：底下垫一小团暗，字才看得清 */
  .hint::before { content: ""; position: absolute; left: 50%; top: -16px; width: 150px; height: 64px; transform: translateX(-50%); z-index: -1;
    background: radial-gradient(closest-side, rgba(var(--night-rgb), .9), rgba(var(--night-rgb), 0)); }
  .hint-line { width: 1px; height: 26px; background: linear-gradient(#fff, rgba(255, 255, 255, 0)); opacity: .5; transform-origin: 50% 0; animation: drip 2.6s var(--slow) infinite; }
  @keyframes drip { 0% { transform: scaleY(0); opacity: 0; } 30% { opacity: .6; } 100% { transform: scaleY(1); opacity: 0; } }

  /* —— 第二到第六幕：造好了才出名字，下面一个「进去」。
     没有 3D：名字照 v3.1 站在左下（一个字一个字写出来）。有 3D：名字是星尘聚的、摆在那样造物旁边，页面里这份跟着它摆（home.ts 每帧量），
     「进去」跟在名字下面正中，点得到的范围不小于 44 × 44 —— */
  .act { position: absolute; inset: 0; }
  .card { position: absolute; left: max(24px, 6.5vw); bottom: calc(max(9vh, 60px) + 64px); width: min(560px, calc(100% - 48px)); padding: 0; transition: opacity .5s var(--ease); }
  .card::before { content: ""; position: absolute; left: -60px; right: -40px; top: -40px; bottom: -36px; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgba(var(--night-rgb), .55), rgba(var(--night-rgb), 0)); }
  .act:not(:global(.on)) .card { opacity: 0; }
  .act:not(:global(.on)) .card .go { pointer-events: none; }
  .act-name { margin: 0 0 22px; font: 300 clamp(30px, 3.4vw, 44px)/1.1 var(--display); letter-spacing: .28em; color: #f4f4f4; text-shadow: 0 0 24px rgba(var(--night-rgb), .7); }
  :global(html[data-lang="zh"]) .act-name { font-family: var(--display-zh); letter-spacing: .48em; }
  .go { pointer-events: auto; display: inline-flex; align-items: center; justify-content: center; gap: 12px; padding: 10px 0; min-height: 44px; box-sizing: border-box;
    font: 300 11.5px/1 var(--display); letter-spacing: .26em; text-transform: uppercase; color: #fff; border-bottom: 1px solid rgba(255, 255, 255, .35); transition: border-color .3s var(--ease), gap .3s var(--ease); }
  :global(html[data-lang="zh"]) .go { font: 300 14px/1 var(--display-zh); letter-spacing: .4em; }
  .go:focus-visible { border-color: #fff; gap: 18px; }
  @media (hover: hover) { .go:hover { border-color: #fff; gap: 18px; } }
  .go .arr { font-family: var(--display-zh); letter-spacing: 0; }
  /* 有 3D：卡片摆到 3D 那份名字在屏幕上的位置（transform 由 home.ts 每帧写）；「进去」在名字下面正中 */
  :global(html[data-gl="yes"][data-dust="yes"]) .card { left: 0 !important; top: 0; right: auto !important; bottom: auto !important; width: auto !important; will-change: transform; transition: opacity .35s var(--ease); }
  :global(html[data-gl="yes"][data-dust="yes"]) .card::before { display: none; }
  :global(html[data-gl="yes"][data-dust="yes"]) .act-name { margin: 0; overflow: hidden; white-space: nowrap; font-size: 1px; line-height: 1; }
  :global(html[data-gl="yes"][data-dust="yes"]) .act-name .chs { display: none; }
  :global(html[data-gl="yes"][data-dust="yes"]) .act-name :global(.sr) { position: static !important; width: auto; height: auto; clip: auto; margin: 0; }
  :global(html[data-gl="yes"][data-dust="yes"]) .go { position: absolute; left: 50%; top: calc(100% + 4px); transform: translateX(-50%); white-space: nowrap; padding: 10px 6px;
    text-shadow: 0 0 10px rgba(var(--night-rgb), .9), 0 0 3px rgba(var(--night-rgb), .8); }

  /* —— 第七幕「开天」：那句话在星空里聚出来（有 3D 时是星聚的，水里有倒影），天上挂着五个名字；页脚是片尾字幕。
     位置跟画面对好了：字压在星云中间那块相对暗的地方（genesis.ts 读 .motto 的位置，把那一块天留暗），页脚落在水面那面镜子上 —— */
  .act7 { --end-y: 58%; }
  .act7 .end { position: absolute; left: 50%; top: var(--end-y); transform: translate(-50%, -50%); width: min(980px, calc(100% - 40px)); text-align: center; }
  .act7 .end::before { content: ""; position: absolute; left: -6%; right: -6%; top: -70%; bottom: -60%; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgba(var(--night-rgb), .42), rgba(var(--night-rgb), .16) 62%, rgba(var(--night-rgb), 0)); opacity: 0; transition: opacity 2.4s var(--ease); }
  :global(html[data-gl="yes"][data-dust="yes"]) .act7 .end::before { display: none; }
  .motto { margin: 0 0 30px; font: 300 clamp(20px, 2.15vw, 30px)/1.5 var(--display); letter-spacing: .06em; color: #fff;
    text-shadow: 0 0 2px rgba(var(--night-rgb), .5), 0 0 26px rgba(var(--night-rgb), .75), 0 0 60px rgba(var(--night-rgb), .5);
    opacity: 0; filter: blur(6px); transition: opacity 2.4s var(--slow), filter 2.4s var(--slow); }
  :global(html[data-lang="zh"]) .motto { font-family: var(--display-zh); letter-spacing: .2em; }
  /* 两半各占一行（3D 里那份也是两行，两份对得上） */
  .mh { display: block; }
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 34px; margin: 0; opacity: 0; transform: translateY(6px); transition: opacity 1.2s var(--ease) .9s, transform 1.2s var(--ease) .9s; }
  .links a { pointer-events: auto; font: 300 13.5px/1 var(--display); letter-spacing: .24em; padding: 9px 0 9px .24em; color: #e2e2e2; border-bottom: 1px solid transparent;
    text-shadow: 0 0 14px rgba(var(--night-rgb), .85), 0 0 3px rgba(var(--night-rgb), .6); transition: color .3s var(--ease), border-color .3s var(--ease); }
  :global(html[data-lang="zh"]) .links a { font: 300 14px/1 var(--display-zh); letter-spacing: .36em; padding-left: .36em; }
  .links a:focus-visible { color: #fff; border-color: var(--c); }
  @media (hover: hover) { .links a:hover { color: #fff; border-color: var(--c); } }
  /* 页脚：片尾字幕——细、小、居中、行距松、灰一点，一行行淡进来；链接照旧 */
  .act7 .foot { position: absolute; left: 50%; bottom: max(4vh, 22px); transform: translateX(-50%); width: min(760px, calc(100% - 40px)); text-align: center; }
  .act7 .foot::before { content: ""; position: absolute; left: -10%; right: -10%; top: -40%; bottom: -30%; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgba(var(--night-rgb), .5), rgba(var(--night-rgb), 0)); opacity: 0; transition: opacity 1.4s var(--ease) 1s; }
  .cr { opacity: 0; transform: translateY(5px); transition: opacity .5s var(--ease), transform .5s var(--ease); }
  .act7:global(.on) .end::before { opacity: 1; }
  .act7:global(.on) .motto { opacity: 1; filter: none; }
  .act7:global(.on) .links { opacity: 1; transform: none; }
  .act7:global(.on) .foot::before { opacity: 1; }
