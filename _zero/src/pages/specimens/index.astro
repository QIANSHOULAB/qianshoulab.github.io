---
// /specimens 标本（03）：每个标本一张卡，点进去看档案卡和拆解。
import BaseLayout from '../../layouts/BaseLayout.astro';
import T from '../../components/core/T.astro';
import { pairs, ymd } from '../../utils/archive';
import { t } from '../../i18n/ui';
const list = await pairs('specimens');
---
<BaseLayout current="specimens" title={{ en: t('en', 'specimens.h1'), zh: t('zh', 'specimens.h1') }} desc={{ en: t('en', 'specimens.lede'), zh: t('zh', 'specimens.lede') }}>
  <header class="wrap page-head">
    <p class="page-no">03 / 05</p>
    <h1 class="page-h1"><T k="specimens.h1" /></h1>
    <T as="p" class="page-lede" k="specimens.lede" />
  </header>
  <section class="wrap list">
    {list.map((p) => (
      <a class="item slab" href={`/specimens/${p.slug}/`}>
        <div class="id">{p.en.data.id}</div>
        <div class="body">
          <p class="label meta"><time datetime={ymd(p.en.data.date)}>{ymd(p.en.data.date)}</time> · <T en={p.en.data.species} zh={p.zh.data.species} /></p>
          <h2 class="tt"><T en={p.en.data.title} zh={p.zh.data.title} /></h2>
          <T as="p" class="sum" en={p.en.data.summary} zh={p.zh.data.summary} />
          <p class="stack">{p.en.data.modelStack.map((m) => <span class="chip">{m}</span>)}</p>
          <span class="go"><T k="specimens.read" /> <span class="arr" aria-hidden="true">→</span></span>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>
<style>
  .list { margin-top: 64px; display: grid; gap: 16px; }
  .item { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 28px; padding: 30px 30px; }
  .id { font: 500 64px/1 var(--serif); letter-spacing: .02em; color: var(--ink); }
  .meta { margin: 0 0 12px; }
  .tt { font: 500 30px/1.2 var(--serif); letter-spacing: .01em; margin: 0 0 12px; color: var(--ink); }
  :global(html[data-lang="zh"]) .tt { font-family: var(--serif-zh); font-size: 26px; letter-spacing: .04em; }
  .item :global(.sum) { color: var(--ink-2); margin: 0 0 16px; max-width: 46em; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 20px; }
  @media (max-width: 720px) {
    .item { grid-template-columns: 1fr; gap: 10px; padding: 22px 20px; }
    .id { font-size: 44px; }
    .tt { font-size: 24px; }
  }
</style>
