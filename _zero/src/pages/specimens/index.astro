---
// /specimens 样本档案：每个样本一张卡，点进去看档案卡和拆解。
import BaseLayout from '../../layouts/BaseLayout.astro';
import T from '../../components/core/T.astro';
import { pairs, ymd, plainLength } from '../../utils/archive';
import { t } from '../../i18n/ui';
const list = await pairs('specimens');
---
<BaseLayout current="specimens" title={{ en: t('en', 'specimens.h1'), zh: t('zh', 'specimens.h1') }} desc={{ en: t('en', 'specimens.lede'), zh: t('zh', 'specimens.lede') }}>
  <header class="wrap page-head">
    <p class="page-kicker">/specimens</p>
    <h1 class="page-h1"><T k="specimens.h1" /></h1>
    <T as="p" class="page-lede" k="specimens.lede" />
  </header>
  <section class="wrap list">
    {list.map((p) => (
      <a class="item card link-card" href={`/specimens/${p.slug}/`}>
        <div class="ticks" aria-hidden="true"></div>
        <div class="no mono">{p.en.data.id}</div>
        <div class="body">
          <p class="meta mono"><time datetime={ymd(p.en.data.date)}>{ymd(p.en.data.date)}</time> · <T en={p.en.data.species} zh={p.zh.data.species} /></p>
          <h2 class="tt"><T en={p.en.data.title} zh={p.zh.data.title} /></h2>
          <T as="p" class="sum" en={p.en.data.summary} zh={p.zh.data.summary} />
          <p class="stack">{p.en.data.modelStack.map((m) => <span class="chip">{m}</span>)}</p>
          <span class="go"><T k="specimens.read" /> <span class="arr" aria-hidden="true">→</span></span>
          <p class="hl-only mono hlc">chars: en {plainLength(p.en.body).toLocaleString('en-US')} · zh {plainLength(p.zh.body).toLocaleString('en-US')}</p>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>
<style>
  .list { margin-top: 40px; display: grid; gap: 20px; }
  .item { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 24px; padding: 26px 28px; }
  .no { font-size: 56px; line-height: 1; color: var(--signal); letter-spacing: -.04em; }
  .meta { font-size: 12.5px; color: var(--dim); margin: 0 0 8px; }
  .tt { font-size: 26px; line-height: 1.25; margin: 0 0 10px; letter-spacing: -.01em; }
  .item :global(.sum) { color: var(--dim); margin: 0 0 14px; max-width: 46em; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 18px; }
  .hlc { font-size: 12px; margin: 10px 0 0; }
  @media (max-width: 720px) {
    .item { grid-template-columns: 1fr; gap: 8px; padding: 20px; }
    .no { font-size: 40px; }
    .tt { font-size: 22px; }
  }
</style>
