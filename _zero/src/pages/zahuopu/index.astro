---
// /zahuopu 赛博杂货铺（02）：大白话名字的小工具都摆在这儿。每张卡指向工具原来的网址，一个网址都不改。
import BaseLayout from '../../layouts/BaseLayout.astro';
import T from '../../components/core/T.astro';
import { shop } from '../../data/tools';
import { t } from '../../i18n/ui';
import { QIANSHOU } from '../../data/sites';
---
<BaseLayout current="zahuopu" title={{ en: t('en', 'zahuopu.h1'), zh: t('zh', 'zahuopu.h1') }} desc={{ en: t('en', 'zahuopu.lede'), zh: t('zh', 'zahuopu.lede') }}>
  <header class="wrap page-head">
    <p class="page-no">02 / 05</p>
    <h1 class="page-h1"><T k="zahuopu.h1" /></h1>
    <T as="p" class="page-lede" k="zahuopu.lede" />
    <p class="open label"><span class="lamp" aria-hidden="true"></span><T k="zahuopu.sign" /></p>
  </header>

  <section class="wrap shelf" aria-labelledby="menu-t">
    <div class="shelf-h">
      <h2 class="label" id="menu-t"><T k="zahuopu.menu" /></h2>
      <span class="label"><T en={`${String(shop.length).padStart(2, '0')} items`} zh={`共 ${shop.length} 样`} /></span>
    </div>
    <ol class="menu">
      {shop.map((x, i) => (
        <li>
          <a class="item slab" href={x.href}>
            <div class="glyph-tile" aria-hidden="true">
              <span class="glyph" lang="zh-CN">{x.glyph}</span>
              <span class="no">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="body">
              <div class="top">
                <h3 class="name"><T en={x.name.en} zh={x.name.zh} /></h3>
                <span class="price label" aria-hidden="true"><span data-l="en">$0.00</span><span data-l="zh">¥0.00</span></span>
              </div>
              <T as="p" class="sub" en={x.sub.en} zh={x.sub.zh} />
              <p class="what"><T en={x.what.en} zh={x.what.zh} /> <T class="note" en={x.note.en} zh={x.note.zh} /></p>
              <span class="go"><T en={x.go?.en ?? 'Open'} zh={x.go?.zh ?? '打开'} /> <span class="arr" aria-hidden="true">→</span></span>
            </div>
          </a>
        </li>
      ))}
    </ol>
    <a class="temple slab" href={QIANSHOU}>
      <T as="p" class="temple-t" k="zahuopu.also" />
      <span class="go"><span class="label nob">01</span> <T k="zahuopu.alsoGo" /> <span class="arr" aria-hidden="true">→</span></span>
    </a>
  </section>
</BaseLayout>

<style>
  .open { display: inline-flex; align-items: center; gap: 10px; margin: 26px 0 0; }
  .lamp { width: 5px; height: 5px; border-radius: 50%; background: #fff; box-shadow: 0 0 10px rgba(255, 255, 255, .8); animation: breathe 7s ease-in-out infinite; }
  @keyframes breathe { 50% { opacity: .35; } }
  .shelf { margin-top: 64px; }
  .shelf-h { display: flex; justify-content: space-between; align-items: baseline; margin: 0 0 16px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .shelf-h h2 { margin: 0; font-weight: 400; }
  .menu { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .item { display: grid; grid-template-columns: 128px minmax(0, 1fr); height: 100%; }
  .glyph-tile { position: relative; border-right: 1px solid var(--line); min-height: 176px; display: grid; place-items: center; overflow: hidden;
    background: radial-gradient(70% 60% at 50% 100%, rgba(255, 255, 255, .07), rgba(255, 255, 255, 0) 70%); }
  .glyph { font: 500 46px/1 var(--serif-zh); color: #f0f0f0; text-shadow: 0 0 22px rgba(255, 255, 255, .22); }
  .no { position: absolute; left: 12px; top: 12px; font: 400 10.5px/1 var(--mono); letter-spacing: .14em; color: var(--ink-4); }
  .body { padding: 20px 22px; display: flex; flex-direction: column; min-width: 0; }
  .top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .name { margin: 0; font: 600 19px/1.3 var(--sans); color: var(--ink); }
  .price { color: var(--ink-3); }
  .item :global(.sub) { margin: 6px 0 0; font-size: 15px; color: var(--ink); white-space: pre-line; }
  .what { margin: 8px 0 0; font-size: 14px; color: var(--ink-2); line-height: 1.6; }
  .item :global(.note) { color: var(--ink-3); }
  .item .go { margin-top: auto; padding-top: 16px; }
  .temple { margin-top: 16px; padding: 22px 24px; display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; justify-content: space-between; }
  .temple :global(.temple-t) { margin: 0; color: var(--ink-2); font-size: 15px; }
  .nob { color: var(--ink-3); margin-right: 4px; }
  @media (max-width: 860px) { .menu { grid-template-columns: 1fr; } }
  @media (max-width: 520px) {
    .item { grid-template-columns: 1fr; }
    .glyph-tile { border-right: 0; border-bottom: 1px solid var(--line); min-height: 116px; }
  }
</style>
