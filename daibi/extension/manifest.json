{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "__MSG_short_name__",
  "version": "0.4.0",
  "default_locale": "en",
  "description": "__MSG_description__",
  "homepage_url": "https://qianshoulab.github.io/daibi/",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "__MSG_action_title__", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "scripting", "activeTab"],
  "host_permissions": ["https://qianshoulab.github.io/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
