{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShort__",
  "version": "0.4.1",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "homepage_url": "https://qianshoulab.github.io/huayuan/",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "__MSG_cmdDesc__"
    }
  }
}
