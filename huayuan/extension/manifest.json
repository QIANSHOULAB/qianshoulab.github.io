{
  "manifest_version": 3,
  "name": "化缘僧：过路留名，见网扒皮",
  "short_name": "化缘僧",
  "version": "0.3.0",
  "description": "专治防复制网页。客户名录、商品列表，点一下抓成 Excel：自己认列表、自己翻页滚动、化完自己下载，同一个网站第二回照上次的改法办。数据只在本机。",
  "homepage_url": "https://qianshoulab.github.io/huayuan/",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "化缘僧：把这页的列表抓成表",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "专治防复制网页。客户名录、商品列表，点一下抓成 Excel：自己认列表、自己翻页滚动、化完自己下载，同一个网站第二回照上次的改法办。数据只在本机。"
    }
  }
}
