{
  "manifest_version": 3,
  "name": "巡山僧 - 降价补货提醒",
  "short_name": "巡山僧",
  "version": "0.3.0",
  "description": "降价、补货、上新，一变就叫你。打开商品页点一下，价格、库存自己认，到线才弹通知。数据只存在你的浏览器里。",
  "author": "QIANSHOU LAB",
  "homepage_url": "https://qianshoulab.github.io/xunshan/",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "scripting",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "巡山僧",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "app.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
